---
import BaseLayout from './BaseLayout.astro';
import { u } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  date: Date;
  author?: string;
  category?: string;
  hero_image?: string;
  hero_alt?: string;
  gallery?: string[];
}

const { title, description, date, author, category, hero_image, hero_alt = '', gallery = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const heroSrc = hero_image
  ? (hero_image.startsWith('/') && !hero_image.startsWith('//') ? u(hero_image) : hero_image)
  : undefined;
---

<BaseLayout title={`${title} — New Afro`} description={description} image={hero_image}>
  <article class="post">
    <header class="page-header">
      <div class="container-narrow">
        <p class="post-meta eyebrow">
          {category && <span class="post-category">{category}</span>}
          {category && <span class="meta-sep" aria-hidden="true">·</span>}
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {author && <span class="meta-sep" aria-hidden="true">·</span>}
          {author && <span class="post-author">By {author}</span>}
        </p>
        <h1>{title}</h1>
      </div>
    </header>

    {heroSrc && (
      <div class="container">
        <img class="post-hero" src={heroSrc} alt={hero_alt} loading="eager" decoding="async" />
      </div>
    )}

    <div class="container-narrow post-body">
      <slot />
    </div>

    {gallery.length > 0 && (
      <section class="container post-gallery" aria-label="Gallery">
        <ul>
          {gallery.map((src, idx) => (
            <li>
              <img
                src={src.startsWith('/') && !src.startsWith('//') ? u(src) : src}
                alt={`${title} — image ${idx + 1}`}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="container-narrow post-footer">
      <a class="na-btn" href={u('/showroom')}>← Back to journal</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    background: var(--na-paper);
    color: var(--na-ink);
  }

  .page-header {
    padding-block: clamp(var(--na-s-12), 8vw, var(--na-s-16)) var(--na-s-9);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--na-s-4);
    font-family: var(--na-font-headline);
    font-size: var(--na-fs-small);
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    color: var(--na-graphite);
    margin: 0 0 var(--na-s-7);
  }

  .post-category { color: var(--na-bronze-deep, var(--na-bronze)); font-weight: 600; }
  .meta-sep { color: var(--na-fog); }

  .page-header h1 {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(48px, 9vw, 88px);
    line-height: 1.1;
    color: var(--na-ink);
    margin: 0 0 var(--na-s-9);
  }

  .post-hero {
    width: 100%;
    max-height: 600px;
    object-fit: cover;
    margin-bottom: var(--na-s-12);
  }

  .post-body {
    padding-block: var(--na-s-7) var(--na-s-12);
    max-width: 60ch;
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--na-ink);
  }

  .post-body :global(h2) {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.15;
    margin-top: var(--na-s-14);
    margin-bottom: var(--na-s-7);
    color: var(--na-ink);
  }
  .post-body :global(h3) {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.2;
    margin-top: var(--na-s-12);
    margin-bottom: var(--na-s-6);
    color: var(--na-ink);
  }
  .post-body :global(p) { margin: 0 0 var(--na-s-7); max-width: none; }
  .post-body :global(a) {
    color: var(--na-bronze-deep, var(--na-bronze));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .post-body :global(a:hover) { color: var(--na-bronze); }
  .post-body :global(img) { margin-block: var(--na-s-12); }
  .post-body :global(ul),
  .post-body :global(ol) { margin: 0 0 var(--na-s-9) var(--na-s-9); padding: 0; }
  .post-body :global(ul) { list-style: disc; }
  .post-body :global(ol) { list-style: decimal; }
  .post-body :global(li) { margin-bottom: var(--na-s-5); }

  .post-body :global(blockquote) {
    border-left: 2px solid var(--na-bronze);
    padding: 0 var(--na-s-9);
    margin: var(--na-s-12) 0;
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.25;
    color: var(--na-bronze-deep, var(--na-bronze));
  }

  .post-footer {
    padding-block: var(--na-s-9) clamp(var(--na-s-14), 8vw, var(--na-s-16));
  }

  .post-footer .na-btn {
    border-radius: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  .post-gallery {
    padding-block: clamp(var(--na-s-9), 5vw, var(--na-s-12));
  }

  .post-gallery ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--na-s-6);
  }

  .post-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 640px) {
    .post-gallery ul { grid-template-columns: 1fr; }
  }
</style>
