---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';

// Keep About close to the public Wix narrative while the team section gives
// editors a structured place for the current organisation.
const heroLeft  = u('/uploads/about/about-hero.jpg');
const heroRight = u('/uploads/about/about-spread-2.jpg');

const team = [
  {
    name: 'Chéria Essieke-Bayer',
    role: 'Founder & Director',
    image: u('/uploads/about/03-2024-08_HoR_VAUX_LArtiste-03130_edited_edited.jpg'),
    fallback: u('/uploads/about/cheria-essieke-bayer.jpg'),
    email: 'cheria@newafro.net',
  },
  {
    name: 'Gustav Friis',
    role: 'Co-Founder',
    image: u('/uploads/about/04-WhatsApp-20Image-202026-02-17-20at-2009_40_24.jpeg'),
    fallback: u('/uploads/about/gustav-friis.jpg'),
    email: 'gus@newafro.net',
  },
  {
    name: 'Ken Samb',
    role: 'Creative Direction Assistant',
    image: u('/uploads/about/05-Hair-20Story-20Mockup_edited.jpg'),
    fallback: u('/uploads/about/ken-samb.jpg'),
    email: 'ken.samb@newafro.net',
  },
  {
    name: 'Maria Bayer',
    role: 'Design & Social Media Student Assistant',
    image: u('/uploads/about/06-IMG_8578_heic.png'),
    fallback: u('/uploads/about/maria-bayer.jpg'),
    email: 'maria@newafro.net',
  },
];
---

<BaseLayout
  title="About / Team — New Afro"
  description="New Afro is a cultural platform dedicated to showcasing African contemporary art and making it accessible to wider audiences."
>
  <article class="team-page">
    <header class="page-header">
      <div class="container-narrow">
        <img
          class="page-eyebrow-mark"
          src={u('/logo.png')}
          srcset={`${u('/logo.png')} 1x, ${u('/logo@2x.png')} 2x`}
          alt="New Afro"
          width="56"
          height="45"
          loading="eager"
          decoding="async"
        />
        <h1 class="display about-title">About us</h1>
        <p class="page-deck">
          New Afro is a cultural platform and creative agency connecting African
          and European creative ecosystems.
        </p>
      </div>
    </header>

    <section class="team-intro">
      <div class="container team-intro__grid">
        <div class="team-intro__copy">
          <p>
            We work with artists, cultural institutions, creative entrepreneurs,
            and brands who want to build meaningful, sustainable connections
            across continents.
          </p>
          <p>
            We believe contemporary African creativity is essential to today's
            cultural landscape. Yet access, representation, and market
            understanding remain unequal. New Afro exists to address these gaps,
            both culturally and economically.
          </p>
        </div>
        <figure class="team-intro__media">
          <img src={heroLeft} alt="New Afro team at work" loading="eager" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="practice container">
      <p class="pillar-kicker">Our work is built on two core activities / pillars:</p>
      <h2 class="display practice__title">Cultural &amp; Curatorial Practice</h2>
      <div class="practice__grid">
        <div class="practice__copy">
          <p>
            We conceive and curate exhibitions, pop-ups, and institutional
            collaborations that amplify artists with African backgrounds and
            foster meaningful intercultural dialogue.
          </p>
          <p>
            Our projects challenge dominant narratives and move beyond tokenism.
            We bridge diverse art scenes, amplify voices and artistic
            narratives, and create spaces for reflection, exchange, and
            visibility.
          </p>
          <p>
            We do not curate for representation alone. We curate to reshape how
            art, identity, and society are understood.
          </p>
        </div>
        <figure class="practice__media">
          <img src={heroRight} alt="New Afro curatorial work" loading="eager" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="practice practice--alt container">
      <h2 class="display practice__title">Art.Store &amp; Creative Agency</h2>
      <div class="practice__grid practice__grid--reverse">
        <div class="practice__copy">
          <p>
            We support artists, creative entrepreneurs, and cultural brands
            expanding between African and European markets.
          </p>
          <p>
            Through strategic consulting, positioning, management guidance, and
            network development, we help our clients navigate new ecosystems
            with clarity and confidence.
          </p>
          <p>
            We understand markets, but also mentalities. We translate cultural
            complexity into sustainable opportunity.
          </p>
        </div>
      </div>
    </section>

    <section class="team-grid-section">
      <div class="container">
        <h2 class="display team-grid-section__title">Our Team</h2>
        <hr class="team-grid-section__rule" />
        <ul class="team-grid">
          {team.map(person => (
            <li class="team-card">
              <figure class="team-card__media">
                <img
                  src={person.image}
                  alt={person.name}
                  loading="lazy"
                  decoding="async"
                  onerror={`this.onerror=null;this.src='${person.fallback}'`}
                />
              </figure>
              <p class="team-card__name">{person.name}</p>
              <p class="team-card__role">{person.role}</p>
              <a class="team-card__email" href={`mailto:${person.email}`}>{person.email}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .team-page {
    background: var(--na-cream);
    color: var(--na-ink);
  }

  .page-header {
    padding-block: clamp(var(--na-s-12), 8vw, var(--na-s-16)) var(--na-s-6);
    text-align: center;
  }

  .about-title {
    margin: 0 auto var(--na-s-7);
    max-width: 18ch;
    font-size: clamp(72px, 10vw, 124px);
    font-weight: 300;
    font-style: italic;
    line-height: 0.95;
    color: var(--na-bronze-deep);
  }

  .page-deck {
    font-family: var(--na-font-body);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.5;
    color: var(--na-ink);
    margin: 0 auto;
    max-width: 54ch;
  }

  .team-intro {
    padding-block: var(--na-s-9) var(--na-s-12);
  }

  .team-intro__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(var(--na-s-9), 4vw, var(--na-s-14));
    align-items: start;
  }

  .team-intro__copy {
    align-self: center;
    text-align: center;
  }

  .team-intro__copy p,
  .practice__copy p {
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--na-ink);
    margin: 0 auto var(--na-s-5);
    max-width: 60ch;
  }

  .team-intro__media {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--na-clay);
    border: 8px solid var(--na-bronze-deep);
    box-shadow: 0 8px 0 rgba(74, 43, 8, 0.18);
  }

  .team-intro__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .practice {
    padding-block: clamp(var(--na-s-9), 5vw, var(--na-s-12));
  }

  .pillar-kicker {
    margin: 0 auto var(--na-s-8);
    max-width: 44ch;
    text-align: center;
    font-family: var(--na-font-display);
    font-size: clamp(18px, 2vw, 22px);
    font-style: italic;
    color: var(--na-bronze-deep);
  }

  .practice__title {
    font-style: italic;
    font-weight: 300;
    text-align: center;
    margin: 0 auto var(--na-s-8);
    max-width: 14ch;
    font-size: clamp(32px, 5vw, 56px);
    color: var(--na-ink);
  }

  .practice__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--na-s-9), 4vw, var(--na-s-14));
    align-items: center;
  }

  .practice__copy {
    align-self: center;
    text-align: center;
  }

  .practice__grid--reverse .practice__copy {
    margin-left: auto;
    margin-right: auto;
  }

  .practice__media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 8px solid var(--na-bronze-deep);
    box-shadow: 0 8px 0 rgba(74, 43, 8, 0.18);
  }

  .practice__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-grid-section {
    background: var(--na-cream-warm);
    padding-block: clamp(var(--na-s-14), 8vw, var(--na-s-16));
    text-align: center;
  }

  .team-grid-section__title {
    font-style: italic;
    font-weight: 300;
    margin: 0 0 var(--na-s-5);
    font-size: clamp(36px, 6vw, 64px);
  }

  .team-grid-section__rule {
    border: 0;
    border-top: 1px solid var(--na-bronze);
    width: 64px;
    margin: 0 auto var(--na-s-12);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(var(--na-s-7), 2vw, var(--na-s-9));
  }

  .team-card {
    text-align: center;
  }

  .team-card__media {
    margin: 0 auto var(--na-s-6);
    width: 168px;
    height: 168px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--na-clay);
  }

  .team-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-card__name {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 1.6vw, 22px);
    margin: 0 0 var(--na-s-3);
    color: var(--na-ink);
  }

  .team-card__role {
    font-family: var(--na-font-headline);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    color: var(--na-graphite);
    margin: 0 0 var(--na-s-3);
  }

  .team-card__email {
    font-family: var(--na-font-body);
    font-size: 13px;
    color: var(--na-bronze-deep);
    text-decoration: none;
  }

  .team-card__email:hover {
    color: var(--na-bronze);
    text-decoration: underline;
  }

  @media (max-width: 1000px) {
    .team-intro__grid,
    .practice__grid {
      grid-template-columns: 1fr;
    }

    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--na-s-9);
    }
  }

  @media (max-width: 480px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
