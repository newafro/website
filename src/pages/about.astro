---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';

// Keep About close to the public Wix narrative while the team section gives
// editors a structured place for the current organisation.
const heroLeft  = u('/uploads/about/01-IMG_6772.jpeg');
const heroRight = u('/uploads/about/02-2fbda9_32a2c7a9b85a4d4f8cbd647a8fe33219-mv2_png.avif');

const team = [
  {
    name: 'Chéria Essieke-Bayer',
    role: 'Founder & Director',
    image: u('/uploads/about/03-2024-08_HoR_VAUX_LArtiste-03130_edited_edited.jpg'),
    fallback: u('/uploads/about/cheria-essieke-bayer.jpg'),
    email: 'cheria@newafro.net',
  },
  {
    name: 'Gustav Friis',
    role: 'Co-Founder',
    image: u('/uploads/about/04-WhatsApp-20Image-202026-02-17-20at-2009_40_24.jpeg'),
    fallback: u('/uploads/about/gustav-friis.jpg'),
    email: 'gus@newafro.net',
  },
  {
    name: 'Ken Samb',
    role: 'Creative Direction Assistant',
    image: u('/uploads/about/05-Hair-20Story-20Mockup_edited.jpg'),
    fallback: u('/uploads/about/ken-samb.jpg'),
    email: 'ken.samb@newafro.net',
  },
  {
    name: 'Maria Bayer',
    role: 'Design & Social Media Student Assistant',
    image: u('/uploads/about/06-IMG_8578_heic.png'),
    fallback: u('/uploads/about/maria-bayer.jpg'),
    email: 'maria@newafro.net',
  },
];
---

<BaseLayout
  title="About / Team — New Afro"
  description="New Afro is a cultural platform dedicated to showcasing African contemporary art and making it accessible to wider audiences."
>
  <article class="team-page">
    <header class="page-header">
      <div class="container-narrow">
        <img
          class="page-eyebrow-mark"
          src={u('/logo.png')}
          srcset={`${u('/logo.png')} 1x, ${u('/logo@2x.png')} 2x`}
          alt="New Afro"
          width="56"
          height="45"
          loading="eager"
          decoding="async"
        />
        <h1 class="display-page">ABOUT</h1>
        <p class="page-deck">
          New Afro is a cultural platform dedicated to showcasing African
          contemporary art and making it accessible to wider audiences.
        </p>
      </div>
    </header>

    <section class="team-intro">
      <div class="container team-intro__grid">
        <div class="team-intro__copy">
          <p>
            Built on art curation and the Art.store, New Afro creates
            opportunities for artists with African backgrounds to share their
            work internationally. We work with artists, cultural institutions,
            creative entrepreneurs, and brands who want to build meaningful,
            sustainable connections across continents.
          </p>
        </div>
        <figure class="team-intro__media">
          <img src={heroLeft} alt="New Afro team at work" loading="eager" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="practice container">
      <h2 class="display practice__title">Cultural &amp; Curatorial Practice</h2>
      <div class="practice__grid">
        <p>
          Through curated exhibitions with international cultural institutions,
          we provide a platform for emerging and established artists to explore
          identity, heritage, and social change. Our work bridges cultural art
          scenes, amplifies diverse voices and artistic narratives, and
          challenges barriers in the art world.
        </p>
        <figure class="practice__media">
          <img src={heroRight} alt="New Afro curatorial work" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="practice practice--alt container">
      <h2 class="display practice__title">Art.Store &amp; Creative Agency</h2>
      <div class="practice__grid practice__grid--reverse">
        <p>
          Through the New Afro Art.Store, we offer a selection of prints and
          original artworks that make African contemporary art easier to access.
          Our agency work supports artists, creative entrepreneurs, and cultural
          brands expanding between African and European markets with strategy,
          positioning, and trusted creative networks.
        </p>
      </div>
    </section>

    <section class="team-grid-section">
      <div class="container">
        <h2 class="display team-grid-section__title">Our Team</h2>
        <hr class="team-grid-section__rule" />
        <ul class="team-grid">
          {team.map(person => (
            <li class="team-card">
              <figure class="team-card__media">
                <img
                  src={person.image}
                  alt={person.name}
                  loading="lazy"
                  decoding="async"
                  onerror={`this.onerror=null;this.src='${person.fallback}'`}
                />
              </figure>
              <p class="team-card__name">{person.name}</p>
              <p class="team-card__role">{person.role}</p>
              <a class="team-card__email" href={`mailto:${person.email}`}>{person.email}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .team-page {
    background: var(--na-cream);
    color: var(--na-ink);
  }

  .page-header {
    padding-block: clamp(var(--na-s-12), 8vw, var(--na-s-16)) var(--na-s-9);
    text-align: center;
  }

  .page-header h1.display-page {
    margin: 0 auto var(--na-s-7);
    max-width: 18ch;
  }

  .page-deck {
    font-family: var(--na-font-body);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.5;
    color: var(--na-ink);
    margin: 0 auto;
    max-width: 60ch;
  }

  .team-intro {
    padding-block: var(--na-s-9) var(--na-s-12);
  }

  .team-intro__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(var(--na-s-9), 4vw, var(--na-s-14));
    align-items: start;
  }

  .team-intro__copy p {
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--na-ink);
    margin: 0 0 var(--na-s-7);
    max-width: 60ch;
  }

  .team-intro__media {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--na-clay);
  }

  .team-intro__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .practice {
    padding-block: clamp(var(--na-s-9), 5vw, var(--na-s-12));
  }

  .practice__title {
    font-style: italic;
    font-weight: 300;
    text-align: center;
    margin: 0 0 var(--na-s-9);
    font-size: clamp(32px, 5vw, 56px);
    color: var(--na-ink);
  }

  .practice__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--na-s-9), 4vw, var(--na-s-14));
    align-items: center;
  }

  .practice__grid p {
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--na-ink);
    margin: 0;
    max-width: 60ch;
  }

  .practice__grid--reverse p {
    margin-left: auto;
  }

  .practice__media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .practice__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-grid-section {
    background: var(--na-cream-warm);
    padding-block: clamp(var(--na-s-14), 8vw, var(--na-s-16));
    text-align: center;
  }

  .team-grid-section__title {
    font-style: italic;
    font-weight: 300;
    margin: 0 0 var(--na-s-5);
    font-size: clamp(36px, 6vw, 64px);
  }

  .team-grid-section__rule {
    border: 0;
    border-top: 1px solid var(--na-bronze);
    width: 64px;
    margin: 0 auto var(--na-s-12);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(var(--na-s-7), 2vw, var(--na-s-9));
  }

  .team-card {
    text-align: center;
  }

  .team-card__media {
    margin: 0 auto var(--na-s-6);
    width: 168px;
    height: 168px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--na-clay);
  }

  .team-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-card__name {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 1.6vw, 22px);
    margin: 0 0 var(--na-s-3);
    color: var(--na-ink);
  }

  .team-card__role {
    font-family: var(--na-font-headline);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    color: var(--na-graphite);
    margin: 0 0 var(--na-s-3);
  }

  .team-card__email {
    font-family: var(--na-font-body);
    font-size: 13px;
    color: var(--na-bronze-deep);
    text-decoration: none;
  }

  .team-card__email:hover {
    color: var(--na-bronze);
    text-decoration: underline;
  }

  @media (max-width: 1000px) {
    .team-intro__grid,
    .practice__grid {
      grid-template-columns: 1fr;
    }

    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--na-s-9);
    }
  }

  @media (max-width: 480px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
