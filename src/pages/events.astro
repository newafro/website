---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { u } from '../lib/url';

const events = (await getCollection('events', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const labelFor = (event) => event.data.cta_label ?? (
  event.data.status === 'closed' ? 'Closed' :
  event.data.status === 'sold_out' ? 'Sold out' :
  event.data.status === 'cancelled' ? 'Cancelled' :
  'Learn more'
);

const isClosed = (event) => ['closed', 'sold_out', 'cancelled'].includes(event.data.status);
---

<BaseLayout
  title="Events — New Afro"
  description="Exhibitions, pop-ups, and live programming around African creativity."
>
  <article class="events-page">
    <header class="events-hero">
      <video
        class="events-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={u('/uploads/video/events-hero-poster.png')}
        aria-hidden="true"
      >
        <source src={u('/uploads/video/events-hero.mp4')} type="video/mp4" />
      </video>
      <div class="events-hero__scrim" aria-hidden="true"></div>
      <h1>EVENTS</h1>
    </header>

    <section class="events-shell">
      <div class="events-list">
        {events.map(event => {
          const image = event.data.hero_image
            ? (event.data.hero_image.startsWith('/') ? u(event.data.hero_image) : event.data.hero_image)
            : undefined;
          const href = event.data.cta_url || u(`/event-details-registration/${event.slug}`);
          return (
            <article class="event-card">
              <a class="event-card__media" href={href} aria-label={event.data.title}>
                {image && <img src={image} alt={event.data.hero_alt ?? ''} loading="lazy" decoding="async" />}
              </a>
              <div class="event-card__body">
                <h2>{event.data.title}</h2>
                <p>{event.data.date_label} <span aria-hidden="true">|</span> {event.data.location}</p>
                {isClosed(event) ? (
                  <button class="event-card__btn" disabled>{labelFor(event)}</button>
                ) : (
                  <a class="event-card__btn" href={href}>{labelFor(event)}</a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .events-page {
    background: #4a2b08;
    color: var(--na-ink);
  }

  .events-hero {
    position: relative;
    min-height: 325px;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #2a1a06;
  }

  .events-hero__video,
  .events-hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .events-hero__video {
    object-fit: cover;
    z-index: -2;
  }

  .events-hero__scrim {
    z-index: -1;
    background: rgba(0, 0, 0, 0.18);
  }

  .events-hero h1 {
    font-family: var(--na-font-page-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(72px, 10vw, 120px);
    line-height: 1;
    color: var(--na-cream-warm);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .events-shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 20px 96px;
    background: #bdb39f;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  .event-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 320px;
    background: #fff9eb;
  }

  .event-card__media {
    display: block;
    overflow: hidden;
    background: #ded9c7;
  }

  .event-card__media img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .event-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 48px 56px;
    text-align: center;
  }

  .event-card h2 {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1.2;
    letter-spacing: 0;
    margin: 0;
    color: #000;
  }

  .event-card p {
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.4;
    margin: 0;
    color: #000;
    max-width: none;
  }

  .event-card__btn {
    min-width: 160px;
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 28px;
    border-radius: 999px;
    background: #6b4708;
    color: #fff;
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1;
    text-decoration: none;
  }

  button.event-card__btn {
    opacity: 1;
    cursor: default;
  }

  .event-card__btn:hover {
    color: #fff;
    background: #573811;
  }

  @media (max-width: 760px) {
    .events-hero {
      min-height: 240px;
    }

    .events-hero h1 {
      font-size: clamp(52px, 15vw, 64px);
      letter-spacing: 0;
    }

    .events-shell {
      padding: 16px 16px 64px;
    }

    .events-list {
      gap: 56px;
    }

    .event-card {
      grid-template-columns: 1fr;
    }

    .event-card__media img {
      min-height: 250px;
      aspect-ratio: 4 / 3;
    }

    .event-card__body {
      min-height: 250px;
      padding: 36px 28px;
    }
  }
</style>
