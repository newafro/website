---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { u } from '../lib/url';

const artists = (await getCollection('artists', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const portraitOverrides = new Map([
  ['benjamin-abana', '/uploads/community/02-e7ed0d_1244b9e3eb5a4ea69bfee84a05669fd2-mv2.jpg'],
  ['tobi-onabolu', '/uploads/community/05-d5693e_e01c090b67fb4099aac3f41408abc745-mv2.jpg'],
  ['benga-mavinga', '/uploads/community/08-d5693e_dbfba9bc54d940a887279e3d4d0a48dc-mv2.jpg'],
  ['eveline-soum', '/uploads/community/09-d5693e_af0048380a524a06bfd98b2ee62a5e7b-mv2.jpg'],
  ['ibaaku', '/uploads/community/10-7273cd_5ec88f9a32bb462e83cb751970e6e43a-mv2.jpg'],
  ['neo', '/uploads/community/12-7273cd_7a65e39878884b4987e92dadac95b0b1-mv2.jpg'],
  ['lyanel', '/uploads/community/13-7273cd_a51885a3ad724341bafd98ec80b034f6-mv2.jpeg'],
]);

const partners = [
  { name: 'Institut Français Mainz', image: u('/uploads/community/17-7273cd_d8b78cb3d75a45a4aa0487356ec4e120-mv2.png') },
  { name: 'Institut Français Deutschland', image: u('/uploads/community/18-7273cd_cc00a59eb65b45b3909e44d7b3580982-mv2.png') },
  { name: 'VAUX Sekt-Manufaktur', image: u('/uploads/community/19-7273cd_b69b49a6fd904a1eafa0fa93becbe8b2-mv2.png') },
  { name: 'CinéMayence', image: u('/uploads/community/20-7273cd_a031feaa13a244779b35b152b13614cc-mv2.png') },
  { name: 'NEAR Week', image: u('/uploads/community/21-7273cd_ef7e6f58ad1d4262aa769d288fd3cf6e-mv2.jpg') },
  { name: 'Kulturzentrum Mainz', image: u('/uploads/community/22-7273cd_37db48e9420b4c94af869d6e268ef0d0-mv2.jpg') },
  { name: 'P. Art. Mainz', image: u('/uploads/community/23-7273cd_7fbf2d35e8084ad899db0882d0d14faf-mv2.jpg') },
  { name: 'Pulse', image: u('/uploads/community/24-7273cd_5fc087ad6e0247a19097016e7aa9981a-mv2.png') },
  { name: 'Villa Vinum', image: u('/uploads/community/25-7273cd_fbdd3a66ca67408da0e1d4bd585e2ec6-mv2.jpg') },
  { name: 'Goethe-Institut', image: u('/uploads/community/26-7273cd_c980195e61d8464f89c04da544e829c2-mv2.png') },
  { name: 'Charlotte am Main', image: u('/uploads/community/27-7273cd_4e9a1058bc294a15868d4c923785af59-mv2.jpg') },
  { name: "M'ANAPPELLE", image: u('/uploads/community/28-7273cd_85e567f9ec554dfeb6ded5da23b852f5-mv2.jpg') },
  { name: 'Dandy & Co', image: u('/uploads/community/29-7273cd_5dff59bcadd3476f8f6a1337b93d7d5a-mv2.jpg') },
  { name: 'Nil+Mon', image: u('/uploads/community/30-7273cd_21d72018c8fc468190892c5ef6143c84-mv2.png') },
  { name: 'Unternehmen Start', image: u('/uploads/community/31-7273cd_f9854ead37374e648bfec598b0079790-mv2.webp') },
  { name: 'Oloro', image: u('/uploads/community/32-7273cd_1dd6899fea8c4df4860ce3f32e44075e-mv2.png') },
];
---

<BaseLayout
  title="Community — New Afro"
  description="Artists, collaborators, and partners connected through the New Afro programme."
>
  <article class="community-page">
    <header class="community-hero">
      <video
        class="community-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={u('/uploads/video/community-hero-poster.png')}
        aria-hidden="true"
      >
        <source src={u('/uploads/video/community-hero.mp4')} type="video/mp4" />
      </video>
      <div class="community-hero__scrim" aria-hidden="true"></div>
      <div class="community-hero__inner">
        <h1>COMMUNITY</h1>
        <p>The Power to connect and create.</p>
      </div>
    </header>

    <section class="community-section">
      <div class="container">
        <header class="section-heading">
          <h2>Artists and Creatives</h2>
        </header>

        <div class="artist-grid">
          {artists.map(artist => {
            const rawPortrait = portraitOverrides.get(artist.slug) ?? artist.data.portrait;
            const portrait = rawPortrait
              ? (rawPortrait.startsWith('/') ? u(rawPortrait) : rawPortrait)
              : undefined;
            return (
              <a class="artist-card" href={u(`/artists/${artist.slug}`)} aria-label={`View ${artist.data.name}`}>
                {portrait && (
                  <img
                    src={portrait}
                    alt={artist.data.portrait_alt ?? `Portrait of ${artist.data.name}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="artist-card__body">
                  <h3>{artist.data.name}</h3>
                  {artist.data.role && <p class="artist-role">{artist.data.role}</p>}
                  <p>{artist.data.short_bio}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="community-section community-section--partners">
      <div class="container">
        <header class="section-heading">
          <h2>Collaborators &amp; Partners</h2>
        </header>

        <ul class="partner-grid" aria-label="Partner organisations">
          {partners.map(partner => (
            <li>
              <img src={partner.image} alt={partner.name} loading="eager" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .community-page {
    background: #fff;
    color: #000;
  }

  .community-hero {
    position: relative;
    min-height: 520px;
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    background: #2a1a06;
  }

  .community-hero__video,
  .community-hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .community-hero__video {
    object-fit: cover;
    z-index: -2;
  }

  .community-hero__scrim {
    background: rgba(0, 0, 0, 0.36);
    z-index: -1;
  }

  .community-hero h1 {
    font-family: var(--na-font-page-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(60px, 9vw, 116px);
    line-height: 1;
    letter-spacing: 0.02em;
    color: #fff;
    margin: 0 0 18px;
  }

  .community-hero p {
    font-family: var(--na-font-display);
    font-style: italic;
    font-size: clamp(22px, 3vw, 34px);
    color: #fff;
    margin: 0;
    max-width: none;
  }

  .community-section {
    padding-block: clamp(72px, 7vw, 110px);
  }

  .section-heading {
    text-align: center;
    margin-bottom: clamp(48px, 6vw, 76px);
  }

  .section-heading h2 {
    font-family: var(--na-font-page-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(48px, 7vw, 108px);
    line-height: 0.95;
    color: #6f4321;
    margin: 0;
  }

  .artist-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px 32px;
  }

  .artist-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #ded9c7;
    filter: grayscale(1);
    transition:
      filter var(--na-dur-base) var(--na-ease),
      transform var(--na-dur-base) var(--na-ease);
  }

  .artist-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .artist-card:hover img,
  .artist-card:focus-visible img {
    filter: grayscale(0) saturate(1.08);
    transform: scale(1.012);
  }

  .artist-card:focus-visible {
    outline: 2px solid var(--na-bronze);
    outline-offset: 8px;
  }

  .artist-card__body {
    padding-top: 18px;
    text-align: center;
  }

  .artist-card h3 {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    margin: 0 0 6px;
  }

  .artist-role {
    color: #6b4708;
    font-size: 14px;
    margin: 0 0 10px;
  }

  .artist-card p {
    font-size: 15px;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 30ch;
  }

  .community-section--partners {
    background: #fbf7ed;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partner-grid li {
    min-height: 140px;
    display: grid;
    place-items: center;
    background: #fff;
    padding: 24px;
  }

  .partner-grid img {
    max-width: 100%;
    max-height: 84px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .artist-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .partner-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .community-hero {
      min-height: 360px;
    }

    .community-hero h1 {
      font-size: clamp(46px, 14vw, 58px);
      letter-spacing: 0.01em;
    }

    .artist-grid {
      grid-template-columns: 1fr;
    }

    .partner-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .partner-grid li {
      min-height: 118px;
      padding: 18px;
    }
  }
</style>
