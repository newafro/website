---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { u } from '../lib/url';

const artists = (await getCollection('artists', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const partners = [
  { name: 'Institut Français Mainz', image: u('/uploads/partners/institut-francais-mainz.png') },
  { name: 'Institut Français Deutschland', image: u('/uploads/partners/institut-francais-deutschland.png') },
  { name: 'VAUX Sekt-Manufaktur', image: u('/uploads/partners/vaux-sekt-manufaktur.png') },
  { name: 'NEAR Week', image: u('/uploads/community/19-7273cd_b69b49a6fd904a1eafa0fa93becbe8b2-mv2.png') },
  { name: 'P. Art.', image: u('/uploads/community/20-7273cd_a031feaa13a244779b35b152b13614cc-mv2.png') },
];
---

<BaseLayout
  title="Community — New Afro"
  description="Artists, collaborators, and partners connected through the New Afro programme."
>
  <article class="community-page">
    <header class="community-hero">
      <video
        class="community-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={u('/uploads/video/community-hero-poster.png')}
        aria-hidden="true"
      >
        <source src={u('/uploads/video/community-hero.mp4')} type="video/mp4" />
      </video>
      <div class="community-hero__scrim" aria-hidden="true"></div>
      <div class="community-hero__inner">
        <h1>COMMUNITY</h1>
        <p>The Power to connect and create.</p>
      </div>
    </header>

    <section class="community-section">
      <div class="container">
        <header class="section-heading">
          <h2>Artists &amp; Creatives</h2>
        </header>

        <div class="artist-grid">
          {artists.map(artist => {
            const portrait = artist.data.portrait
              ? (artist.data.portrait.startsWith('/') ? u(artist.data.portrait) : artist.data.portrait)
              : undefined;
            return (
              <article class="artist-card">
                {portrait && (
                  <img
                    src={portrait}
                    alt={artist.data.portrait_alt ?? `Portrait of ${artist.data.name}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="artist-card__body">
                  <h3>{artist.data.name}</h3>
                  {artist.data.role && <p class="artist-role">{artist.data.role}</p>}
                  <p>{artist.data.short_bio}</p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="community-section community-section--partners">
      <div class="container">
        <header class="section-heading">
          <h2>Collaborators &amp; Partners</h2>
        </header>

        <ul class="partner-grid" aria-label="Partner organisations">
          {partners.map(partner => (
            <li>
              <img src={partner.image} alt={partner.name} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .community-page {
    background: #fff;
    color: #000;
  }

  .community-hero {
    position: relative;
    min-height: 520px;
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    background: #2a1a06;
  }

  .community-hero__video,
  .community-hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .community-hero__video {
    object-fit: cover;
    z-index: -2;
  }

  .community-hero__scrim {
    background: rgba(0, 0, 0, 0.36);
    z-index: -1;
  }

  .community-hero h1 {
    font-family: var(--na-font-page-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(60px, 9vw, 116px);
    line-height: 1;
    letter-spacing: 0.02em;
    color: #fff;
    margin: 0 0 18px;
  }

  .community-hero p {
    font-family: var(--na-font-display);
    font-style: italic;
    font-size: clamp(22px, 3vw, 34px);
    color: #fff;
    margin: 0;
    max-width: none;
  }

  .community-section {
    padding-block: clamp(72px, 7vw, 110px);
  }

  .section-heading {
    text-align: center;
    margin-bottom: clamp(48px, 6vw, 76px);
  }

  .section-heading h2 {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.05;
    margin: 0;
  }

  .artist-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px 32px;
  }

  .artist-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #ded9c7;
  }

  .artist-card__body {
    padding-top: 18px;
    text-align: center;
  }

  .artist-card h3 {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    margin: 0 0 6px;
  }

  .artist-role {
    color: #6b4708;
    font-size: 14px;
    margin: 0 0 10px;
  }

  .artist-card p {
    font-size: 15px;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 30ch;
  }

  .community-section--partners {
    background: #fbf7ed;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partner-grid li {
    min-height: 132px;
    display: grid;
    place-items: center;
    background: #fff;
    padding: 24px;
  }

  .partner-grid img {
    max-width: 100%;
    max-height: 84px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .artist-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .partner-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .community-hero {
      min-height: 360px;
    }

    .artist-grid,
    .partner-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
