---
import { u } from '../lib/url';

const target = u('/about');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The Agency — New Afro</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <style>
      body { font-family: system-ui, sans-serif; padding: 2rem; background: #FBF7ED; color: #321C01; }
      a { color: #573811; }
    </style>
  </head>
  <body>
    <p>This page has moved. Continue to <a href={target}>The Agency</a>.</p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
