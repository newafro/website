---
const adminUrl = '/admin/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="refresh" content={`0; url=${adminUrl}`} />
    <title>New Afro Login</title>
    <link rel="canonical" href={adminUrl} />
  </head>
  <body>
    <p>
      Opening New Afro Studio.
      <a href={adminUrl}>Continue to login</a>.
    </p>
    <script is:inline define:vars={{ adminUrl }}>
      window.location.replace(adminUrl);
    </script>
  </body>
</html>
