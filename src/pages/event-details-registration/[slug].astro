---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map(event => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await event.render();
const heroSrc = event.data.hero_image
  ? (event.data.hero_image.startsWith('/') ? u(event.data.hero_image) : event.data.hero_image)
  : undefined;
const gallery = event.data.gallery ?? [];
---

<BaseLayout title={`${event.data.title} — New Afro`} description={event.data.description ?? `${event.data.title} — ${event.data.date_label}`}>
  <article class="event-detail">
    <header class="event-header">
      <div class="container-narrow">
        <p class="event-kicker">Event</p>
        <h1>{event.data.title}</h1>
        <p class="event-meta">{event.data.date_label} <span aria-hidden="true">|</span> {event.data.location}</p>
      </div>
    </header>

    {heroSrc && (
      <figure class="event-hero container-narrow">
        <img src={heroSrc} alt={event.data.hero_alt ?? event.data.title} loading="eager" decoding="async" />
      </figure>
    )}

    <section class="event-body container-narrow">
      {event.data.body_ready ? (
        <Content />
      ) : (
        <>
          <h2>Archive Record</h2>
          <dl class="event-facts">
            <div>
              <dt>Date</dt>
              <dd>{event.data.date_label}</dd>
            </div>
            <div>
              <dt>Location</dt>
              <dd>{event.data.location}</dd>
            </div>
            {event.data.city && (
              <div>
                <dt>City</dt>
                <dd>{event.data.city}</dd>
              </div>
            )}
          </dl>
        </>
      )}
    </section>

    {gallery.length > 0 && (
      <section class="event-gallery container-narrow" aria-label="Gallery">
        <h2>Gallery</h2>
        <ul>
          {gallery.map((src, idx) => (
            <li>
              <img
                src={src.startsWith('/') ? u(src) : src}
                alt={`${event.data.title} image ${idx + 1}`}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="event-footer container-narrow">
      <a class="event-back" href={u('/events')}>All events</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .event-detail {
    background: #fff;
    color: #000;
  }

  .event-header {
    padding-block: clamp(72px, 8vw, 124px) 36px;
    text-align: center;
  }

  .event-kicker,
  .event-meta {
    font-family: var(--na-font-body);
    font-size: 15px;
    line-height: 1.4;
    color: #6b4708;
    margin: 0 0 20px;
  }

  .event-header h1 {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(44px, 8vw, 88px);
    line-height: 1.05;
    color: #000;
    margin: 0 0 24px;
  }

  .event-hero {
    margin-block: 0 48px;
    overflow: hidden;
    background: #ded9c7;
  }

  .event-hero img {
    width: 100%;
    max-height: 620px;
    object-fit: cover;
  }

  .event-body {
    padding-block: 28px 40px;
    font-family: var(--na-font-body);
    font-size: 17px;
    line-height: 1.65;
  }

  .event-body :global(h2),
  .event-gallery h2 {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.1;
    margin: 0 0 24px;
  }

  .event-body :global(h3) {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 600;
    font-size: 20px;
    margin: 36px 0 12px;
  }

  .event-body :global(p) {
    margin: 0 0 20px;
    max-width: none;
  }

  .event-facts {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  .event-facts div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    padding-top: 16px;
  }

  .event-facts dt {
    font-weight: 700;
  }

  .event-facts dd {
    margin: 0;
  }

  .event-gallery {
    padding-block: 24px 56px;
  }

  .event-gallery ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .event-footer {
    padding-block: 20px 88px;
  }

  .event-back {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 10px 26px;
    border-radius: 999px;
    background: #6b4708;
    color: #fff;
    text-decoration: none;
  }

  .event-back:hover {
    color: #fff;
    background: #573811;
  }

  @media (max-width: 640px) {
    .event-facts div {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .event-gallery ul {
      grid-template-columns: 1fr;
    }
  }
</style>
