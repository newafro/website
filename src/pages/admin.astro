---
import { u } from '../lib/url';

const favicon = u('/favicon.svg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>New Afro Studio</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <style>
      :root {
        --na-paper: #fbf7ed;
        --na-cream: #ded9c7;
        --na-ink: #321c01;
        --na-bronze: #774a11;
        --na-bronze-deep: #5a370b;
        --na-graphite: #4a3520;
      }

      html,
      body {
        background: var(--na-paper);
        color: var(--na-ink);
        margin: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
      }

      .editor-fallback {
        max-width: 640px;
        margin: 64px auto 0;
        padding: 32px clamp(20px, 4vw, 40px);
        border: 1px solid rgba(50, 28, 1, 0.18);
        background: #fff;
        font-size: 15px;
        line-height: 1.55;
      }

      .editor-fallback .eyebrow {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 12px;
        color: var(--na-bronze-deep);
        margin: 0 0 12px;
      }

      .editor-fallback h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-style: italic;
        font-weight: 300;
        font-size: clamp(32px, 5vw, 44px);
        line-height: 1.1;
        margin: 0 0 16px;
        color: var(--na-ink);
      }

      .editor-fallback p {
        margin: 0 0 12px;
        color: var(--na-graphite);
      }

      .editor-fallback code {
        background: var(--na-paper);
        padding: 2px 6px;
        border: 1px solid rgba(50, 28, 1, 0.12);
        font-size: 13px;
      }

      .editor-fallback ul {
        padding-left: 22px;
        margin: 0 0 16px;
      }

      .editor-fallback li {
        margin-bottom: 8px;
      }

      .editor-fallback .note {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid rgba(50, 28, 1, 0.12);
        font-size: 13px;
        color: var(--na-graphite);
      }

      .editor-fallback[hidden] {
        display: none;
      }

      body[data-oauth-state="pending"] #nc-root {
        opacity: 0.16;
        pointer-events: none;
        user-select: none;
      }

      .editor-status {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: grid;
        place-items: center;
        padding: clamp(20px, 5vw, 56px);
        background: rgba(251, 247, 237, 0.9);
        backdrop-filter: blur(8px);
        color: var(--na-graphite);
        font-size: clamp(15px, 1.8vw, 17px);
        line-height: 1.45;
      }

      .editor-status__card {
        max-width: 560px;
        padding: clamp(22px, 4vw, 34px);
        border: 1px solid rgba(90, 55, 11, 0.22);
        background: rgba(255, 252, 245, 0.98);
        box-shadow: 0 22px 70px rgba(50, 28, 1, 0.16);
      }

      .editor-status strong {
        display: block;
        margin-bottom: 8px;
        color: var(--na-ink);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(28px, 5vw, 42px);
        font-style: italic;
        font-weight: 300;
        line-height: 1.05;
      }

      .editor-status__actions {
        margin: 18px 0 0;
        padding-top: 14px;
        border-top: 1px solid rgba(90, 55, 11, 0.16);
        font-size: 13px;
      }

      .editor-status__actions a {
        color: var(--na-bronze-deep);
        font-weight: 600;
      }

      .editor-status[data-state="ready"] {
        display: none;
      }

      .editor-status[hidden] {
        display: none;
      }

      #nc-root {
        position: relative;
        z-index: 1;
      }
    </style>
  </head>
  <body>
    <section class="editor-fallback" id="editor-fallback">
      <p class="eyebrow">New Afro Studio</p>
      <h1>Manage the website</h1>
      <p>
        Sign in with GitHub to edit the New Afro website. Updates go to
        preview first, so the team can review changes before they appear on
        the public site.
      </p>
      <p><strong>Common actions:</strong></p>
      <ul>
        <li>Create or update an event, then review it on preview.</li>
        <li>Publish a journal post with a hero image, gallery, and alt text.</li>
        <li>Add an artist profile for the community page.</li>
        <li>Keep uncertain journal posts as drafts until copy and credits are confirmed.</li>
        <li>Use Figma screenshots or WhatsApp feedback to request layout fixes before production.</li>
      </ul>
      <p>
        Page layout, navigation, forms, and large design changes are still
        handled through preview requests, not direct CMS edits.
      </p>
      <p>
        Preview site: <a href="https://preview.newafro.com">preview.newafro.com</a>
      </p>
      <p class="note">
        If sign-in fails, ask an administrator to confirm your GitHub access to
        <code>newafro/website</code> and the New Afro OAuth proxy.
      </p>
    </section>
    <section class="editor-status" id="editor-status" hidden aria-live="polite">
      <div class="editor-status__card">
        <strong>Website editing is waiting on login setup.</strong>
        <span id="editor-status-detail">
          The preview site is ready, but GitHub sign-in needs the New Afro OAuth proxy before the team can save CMS changes.
          Design review can continue on preview now; only CMS saving should wait.
        </span>
        <p class="editor-status__actions">
          Review site:
          <a href="https://preview.newafro.com">preview.newafro.com</a>
          <br />
          Operator check:
          <a href="https://github.com/newafro/decap-oauth/actions/workflows/operator-access.yml">
            OAuth operator preflight
          </a>
        </p>
      </div>
    </section>

    <script src="https://unpkg.com/decap-cms@3.12.2/dist/decap-cms.js"></script>
    <script is:inline>
      const fallback = document.getElementById('editor-fallback');
      const statusPanel = document.getElementById('editor-status');
      const statusDetail = document.getElementById('editor-status-detail');
      const oauthHost = 'decap-oauth.newafro.com';
      const oauthHealthUrl = 'https://decap-oauth.newafro.com/healthz';
      const oauthDnsUrl = `https://dns.google/resolve?name=${oauthHost}&type=A`;
      const expectedPublicUrl = 'https://decap-oauth.newafro.com';
      const expectedCallbackUrl = `${expectedPublicUrl}/callback?provider=github`;
      const defaultPendingDetail =
        'The preview site is ready, but GitHub sign-in needs the New Afro OAuth proxy before the team can save CMS changes. Design review can continue on preview now; only CMS saving should wait.';

      const showOAuthPending = (message, detail = defaultPendingDetail) => {
        if (!statusPanel) return;

        statusPanel.dataset.state = 'pending';
        document.body.dataset.oauthState = 'pending';
        statusPanel.hidden = false;
        const detail = statusPanel.querySelector('strong');
        if (detail && message) {
          detail.textContent = message;
        }
        if (statusDetail) {
          statusDetail.textContent = detail;
        }
      };

      const explainOAuthHealth = (response, payload) => {
        if (payload?.publicUrl && payload.publicUrl !== expectedPublicUrl) {
          return `The OAuth proxy is online, but Render is using ${payload.publicUrl}. Ask the operator to set PUBLIC_URL=${expectedPublicUrl}.`;
        }

        if (payload?.callbackUrl && payload.callbackUrl !== expectedCallbackUrl) {
          return `The OAuth proxy is online, but GitHub callback setup is wrong. It must use ${expectedCallbackUrl}.`;
        }

        if (payload?.scope && !String(payload.scope).split(',').includes('user')) {
          return 'The OAuth proxy is online, but the GitHub OAuth scope is missing user access. Ask the operator to rerun the OAuth preflight.';
        }

        if (Array.isArray(payload?.missing) && payload.missing.length > 0) {
          return `The OAuth proxy is online, but missing server settings: ${payload.missing.join(', ')}.`;
        }

        if (!response.ok) {
          return 'The OAuth proxy is online, but its health check is not ready. Ask the operator to rerun the OAuth preflight.';
        }

        return defaultPendingDetail;
      };

      const checkOAuthReadiness = async () => {
        try {
          const dnsResponse = await fetch(oauthDnsUrl, { cache: 'no-store' });
          const dnsPayload = await dnsResponse.json();
          const dnsReady =
            dnsResponse.ok &&
            dnsPayload &&
            dnsPayload.Status === 0 &&
            Array.isArray(dnsPayload.Answer) &&
            dnsPayload.Answer.length > 0;

          if (!dnsReady) {
            showOAuthPending('Website editing is waiting on login setup.');
            return;
          }

          const response = await fetch(oauthHealthUrl, {
            cache: 'no-store',
            mode: 'cors',
          });
          const payload = await response.json();

          const healthReady =
            response.ok &&
            payload &&
            payload.ok === true &&
            payload.publicUrl === expectedPublicUrl &&
            payload.callbackUrl === expectedCallbackUrl &&
            String(payload.scope || '').split(',').includes('user');

          if (healthReady) {
            statusPanel.dataset.state = 'ready';
            document.body.dataset.oauthState = 'ready';
            statusPanel.hidden = true;
            return;
          }

          showOAuthPending('Website login needs an OAuth configuration fix.', explainOAuthHealth(response, payload));
        } catch {
          showOAuthPending('Website editing is waiting on login setup.');
        }
      };

      const hideFallbackWhenCmsLoads = () => {
        if (window.CMS && fallback) {
          fallback.hidden = true;
          return true;
        }

        return false;
      };

      const cmsCheck = window.setInterval(() => {
        if (hideFallbackWhenCmsLoads()) {
          window.clearInterval(cmsCheck);
        }
      }, 250);

      window.setTimeout(() => window.clearInterval(cmsCheck), 10000);
      window.addEventListener('load', () => {
        window.setTimeout(hideFallbackWhenCmsLoads, 500);
      });
      checkOAuthReadiness();
    </script>
  </body>
</html>
