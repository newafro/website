---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';

// The poster keeps the page rendered before the video decodes and acts as a
// still fallback when video autoplay is blocked.
const heroVideo  = u('/uploads/video/home-hero.mp4');
const heroPoster = u('/uploads/video/home-hero-poster.png?v=20260606-wix');
const heroFallbackImg = heroPoster;
---

<BaseLayout
  title="New Afro — Where art connects cultures."
  description="A cultural platform and creative agency connecting African and European creative ecosystems."
>
  <section class="home-hero" aria-labelledby="home-headline">
    <div class="home-hero__motion" aria-hidden="true">
      <video
        class="home-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroPoster}
      >
        <source src={heroVideo} type="video/mp4" />
      </video>
      <div class="home-hero__bg" style={`background-image: url(${heroFallbackImg});`}></div>
    </div>
    <div class="home-hero__inner">
      <h1 id="home-headline" class="hero-display home-hero__headline">New Afro</h1>
      <p class="home-hero__sub">The Cultural and Creative Agency</p>
      <div class="home-hero__actions" aria-label="Primary actions">
        <a class="home-hero__btn home-hero__btn--primary" href={u('/agency')}>The Agency</a>
        <a class="home-hero__btn home-hero__btn--secondary" href={u('/projects')}>Curatorial Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 0;
    height: clamp(620px, 55.35vw, 797px);
    width: 100%;
    overflow: hidden;
    color: var(--na-cream-warm);
    isolation: isolate;
  }

  .home-hero__motion {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--na-ink);
  }

  .home-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Fallback image — sits beneath the video, used by prefers-reduced-motion
     and when the video element fails to render. */
  .home-hero__bg {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    transform-origin: center center;
    animation: home-hero-kenburns 24s ease-in-out infinite alternate;
    z-index: -1;
  }

  @keyframes home-hero-kenburns {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  .home-hero__motion::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.06);
    z-index: 1;
  }

  .home-hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(58px, 8vw, 92px) var(--na-s-8) clamp(38px, 5.5vw, 66px);
    width: 100%;
  }

  .home-hero__headline {
    color: var(--na-cream-warm);
    font-size: clamp(58px, 8.4vw, 124px);
    line-height: 0.96;
    margin: 0;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.16);
    white-space: nowrap;
  }

  .home-hero__sub {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.16;
    color: var(--na-cream-warm);
    margin: clamp(8px, 1vw, 14px) 0 0;
    max-width: min(620px, 88vw);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.22);
  }

  .home-hero__actions {
    margin-top: clamp(78px, 14vh, 132px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding-top: 0;
  }

  .home-hero__btn {
    min-width: min(214px, 42vw);
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 22px;
    border: 1px solid rgba(255, 249, 235, 0.86);
    font-family: var(--na-font-ui);
    font-size: clamp(13px, 1vw, 15px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: none;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(5px);
  }

  .home-hero__btn--primary {
    background: var(--na-bronze);
    border-color: var(--na-bronze);
    color: #fff;
  }

  .home-hero__btn--secondary {
    background: rgba(255, 249, 235, 0.78);
    color: var(--na-ink);
  }

  .home-hero__btn:hover {
    transform: translateY(-1px);
  }

  .home-hero__btn--primary:hover {
    background: var(--na-bronze-deep);
    border-color: var(--na-bronze-deep);
    color: #fff;
  }

  .home-hero__btn--secondary:hover {
    background: var(--na-cream-warm);
    color: var(--na-ink);
  }

  @media (max-width: 900px) {
    .home-hero {
      height: calc(100vh - 92px);
      min-height: 560px;
      align-items: center;
    }

    .home-hero__bg {
      background-position: center;
      animation-duration: 30s;
    }

    .home-hero__inner {
      padding: clamp(42px, 13vw, 72px) var(--na-s-8) clamp(34px, 10vw, 58px);
    }

    .home-hero__headline {
      font-size: clamp(48px, 14vw, 62px);
    }

    .home-hero__sub {
      font-size: clamp(22px, 6.4vw, 29px);
      max-width: min(340px, 88vw);
    }

    .home-hero__actions {
      width: min(100%, 360px);
      gap: 10px;
      margin-top: clamp(72px, 14vh, 118px);
    }

    .home-hero__btn {
      width: 100%;
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__video { display: none; }
    .home-hero__bg {
      animation: none;
      transform: none;
      z-index: -1;
    }
  }
</style>
