---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';

const team = [
  { name: 'Chéria Essieke Bayer',  role: 'Founder & Director',                    email: 'cheria@newafro.net' },
  { name: 'Gustav Friis',          role: 'Co-Founder',                            email: 'gus@newafro.net' },
  { name: 'Ken Samb',              role: 'Assistant of Creative Direction',       email: 'kenbougoul@newafro.net' },
  { name: 'Maria Bayer',           role: 'Design & Social Media',                 email: 'maria@newafro.net' },
];
---

<BaseLayout
  title="Contact — New Afro"
  description="Reach out for collaborations, press, artist submissions, or just to say hello."
>
  <article class="contact-page">
    <header class="page-header">
      <div class="container-narrow">
        <img
          class="page-eyebrow-mark"
          src={u('/logo.png')}
          srcset={`${u('/logo.png')} 1x, ${u('/logo@2x.png')} 2x`}
          alt="New Afro"
          width="56"
          height="45"
          loading="eager"
          decoding="async"
        />
        <h1 class="display-page">CONTACT</h1>
        <p class="lede">
          Collaborations, press, artist submissions, or just to say hello —
          we read everything that comes in.
        </p>
      </div>
    </header>

    <section class="container contact">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Direct</h2>
          <p>
            <a href="mailto:hello@newafro.net">hello@newafro.net</a>
          </p>

          <h2>Team</h2>
          <ul class="team-list">
            {team.map(member => (
              <li>
                <a href={`mailto:${member.email}`}>{member.email}</a>
                <span class="team-list__role"> — {member.name}, {member.role}</span>
              </li>
            ))}
          </ul>

          <h2>Cities</h2>
          <p>Mainz · København · Cotonou · Abidjan</p>

          <h2 id="artist-inquiries">Artist inquiries</h2>
          <p>
            Are you an artist or creator? Send us links to your portfolio along
            with a short note about your practice — see
            <a href={u('/general-8')}>artist inquiries</a>.
          </p>

          <h2>Follow</h2>
          <ul class="socials">
            <li><a href="https://www.instagram.com/newafro" rel="me noopener">Instagram</a></li>
            <li><a href="https://www.linkedin.com/company/newafro" rel="me noopener">LinkedIn</a></li>
          </ul>
        </div>

        <form class="contact-form" data-contact-form novalidate>
          <h2>Send a message</h2>

          <label class="field">
            <span class="field-label">Name</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>

          <label class="field">
            <span class="field-label">Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>

          <label class="field">
            <span class="field-label">Subject</span>
            <select name="subject">
              <option>General</option>
              <option>Collaboration</option>
              <option>Artist submission</option>
              <option>Press</option>
            </select>
          </label>

          <label class="field">
            <span class="field-label">Message</span>
            <textarea name="message" rows="6" required></textarea>
          </label>

          <button class="na-btn" type="submit">Send message</button>
          <p class="contact-msg" data-contact-msg hidden></p>
          <p class="contact-fallback">
            Or write to <a href="mailto:hello@newafro.net">hello@newafro.net</a> directly.
          </p>
        </form>
      </div>
    </section>

    <script is:inline>
      (function () {
        const msg = "Contact form coming back online soon — reach us at hello@newafro.net for now.";
        document.querySelectorAll('form[data-contact-form]').forEach(function (form) {
          if (form.dataset.bound === '1') return;
          form.dataset.bound = '1';
          form.addEventListener('submit', function (event) {
            event.preventDefault();
            const out = form.querySelector('[data-contact-msg]');
            if (out) {
              out.textContent = msg;
              out.hidden = false;
            }
          });
        });
      })();
    </script>
  </article>
</BaseLayout>

<style>
  .contact-page {
    background: var(--na-cream);
    color: var(--na-ink);
  }

  .page-header {
    padding-block: clamp(var(--na-s-12), 8vw, var(--na-s-16)) var(--na-s-9);
    text-align: center;
  }

  .page-header h1.display-page {
    margin: 0 auto var(--na-s-7);
    max-width: 18ch;
  }

  .lede {
    font-family: var(--na-font-body);
    font-size: clamp(var(--na-fs-lead), 1.6vw, 22px);
    line-height: 1.5;
    color: var(--na-ink);
    max-width: 60ch;
    margin: 0 auto;
  }

  .contact { padding-block: var(--na-s-9) clamp(var(--na-s-14), 8vw, var(--na-s-16)); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--na-s-16);
    align-items: flex-start;
  }

  .contact-info h2 {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 600;
    font-size: var(--na-fs-small);
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    color: var(--na-ink);
    margin: var(--na-s-12) 0 var(--na-s-5);
  }

  .contact-info h2:first-child { margin-top: 0; }

  .contact-info p {
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--na-ink);
    margin: 0;
    max-width: 60ch;
  }

  .contact-info p + p { margin-top: var(--na-s-5); }

  .contact-info a {
    color: var(--na-bronze-deep, var(--na-bronze));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-info a:hover { color: var(--na-bronze); }

  .team-list {
    display: flex;
    flex-direction: column;
    gap: var(--na-s-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--na-ink);
  }

  .team-list li::before {
    content: '— ';
    color: var(--na-muted);
  }

  .team-list__role {
    color: var(--na-graphite);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--na-s-7);
  }
  .socials a {
    font-family: var(--na-font-headline);
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    font-size: var(--na-fs-small);
  }

  .contact-form {
    background: var(--na-paper);
    padding: clamp(var(--na-s-9), 4vw, var(--na-s-14));
  }

  .contact-form h2 {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    margin: 0 0 var(--na-s-9);
    color: var(--na-ink);
  }

  .field {
    display: block;
    margin-bottom: var(--na-s-7);
  }

  .field-label {
    display: block;
    font-family: var(--na-font-headline);
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    font-size: var(--na-fs-small);
    font-weight: 500;
    color: var(--na-graphite);
    margin-bottom: var(--na-s-3);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: var(--na-s-5) var(--na-s-6);
    background: var(--na-paper);
    border: 1px solid rgba(50, 28, 1, 0.3);
    border-radius: 0;
    font-family: var(--na-font-body);
    font-size: var(--na-fs-body);
    color: var(--na-ink);
    outline: 0;
    transition: border-color var(--na-dur-fast) var(--na-ease);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--na-bronze);
  }

  .field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .na-btn {
    border-radius: 0;
  }

  .contact-msg {
    margin: var(--na-s-7) 0 0;
    color: var(--na-bronze-deep, var(--na-bronze));
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-small);
    line-height: 1.5;
  }

  .contact-fallback {
    margin: var(--na-s-7) 0 0;
    font-family: var(--na-font-body);
    font-size: var(--na-fs-small);
    line-height: 1.5;
    color: var(--na-graphite);
  }

  .contact-fallback a {
    color: var(--na-bronze-deep, var(--na-bronze));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .contact-fallback a:hover { color: var(--na-bronze); }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--na-s-12);
    }
  }
</style>
