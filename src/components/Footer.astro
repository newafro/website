---
import { u } from '../lib/url';

const ourWork = [
  { href: u('/archive'), label: 'THE ARCHIVE' },
  { href: u('/projects'), label: 'PROJECTS' },
  { href: u('/agency'), label: 'THE AGENCY' },
];

const workWithUs = [
  { href: u('/career'), label: 'Career' },
  { href: u('/contact'), label: 'Contact' },
  { href: u('/artist-inquiries'), label: 'Artist Inquiries' },
  { href: u('/about'), label: 'About us' },
];

const information = [
  { href: u('/imprint'), label: 'Imprint' },
  { href: u('/privacy-policy'), label: 'Privacy Policy' },
  { href: u('/terms-and-conditions'), label: 'Terms and Conditions (T&C)' },
];

const socials = [
  {
    href: 'https://www.youtube.com/watch?v=s64Z1QeYEsc',
    label: 'YouTube',
    kind: 'youtube',
  },
  {
    href: 'https://www.facebook.com/culturally.driven.development/',
    label: 'Facebook',
    kind: 'facebook',
  },
  {
    href: 'https://www.instagram.com/new.afro.na/',
    label: 'Instagram',
    kind: 'instagram',
  },
  {
    href: 'https://www.linkedin.com/company/new-afro/',
    label: 'LinkedIn',
    kind: 'linkedin',
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-col" aria-label="Our Work">
      <h3>Our Work</h3>
      <ul>
        {ourWork.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Work with us">
      <h3>Work with us</h3>
      <ul>
        {workWithUs.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Information">
      <h3>Information</h3>
      <ul>
        {information.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col subscribe-col">
      <form class="subscribe" data-newsletter-form novalidate>
        <label class="visually-hidden" for="footer-email">Email address</label>
        <input
          id="footer-email"
          name="email"
          type="email"
          required
          placeholder="Join our newsletter"
          autocomplete="email"
        />
        <button class="subscribe-btn" type="submit">Subscribe Now</button>
        <p class="subscribe-msg" data-newsletter-msg hidden></p>
      </form>

      <nav class="social-links" aria-label="Social links">
        {socials.map(item => (
          <a href={item.href} rel="me noopener" aria-label={item.label}>
            {item.kind === 'youtube' && (
              <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                <circle cx="21" cy="21" r="21" fill="currentColor"></circle>
                <path
                  fill="#fff"
                  d="M30.8 16.4c-.2-.9-.9-1.6-1.8-1.8-1.6-.4-8-.4-8-.4s-6.4 0-8 .4c-.9.2-1.6.9-1.8 1.8-.4 1.7-.4 5.1-.4 5.1s0 3.4.4 5.1c.2.9.9 1.6 1.8 1.8 1.6.4 8 .4 8 .4s6.4 0 8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.7.4-5.1.4-5.1s0-3.4-.4-5.1Z"
                ></path>
                <path fill="currentColor" d="m18.8 24.7 6.1-3.6-6.1-3.6v7.2Z"></path>
              </svg>
            )}
            {item.kind === 'facebook' && (
              <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                <circle cx="21" cy="21" r="21" fill="currentColor"></circle>
                <path
                  fill="#fff"
                  d="M23.7 13.1h3.1V8.8c-.5-.1-2.4-.2-4.5-.2-4.5 0-7.5 2.7-7.5 7.6v4.2h-5v4.8h5v12.1h5.2V25.2h4.4l.8-4.8H20v-3.7c0-1.4.4-2.6 3.7-2.6Z"
                ></path>
              </svg>
            )}
            {item.kind === 'instagram' && (
              <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                <circle cx="21" cy="21" r="21" fill="currentColor"></circle>
                <rect x="12.2" y="12.2" width="17.6" height="17.6" rx="5.2" fill="none" stroke="#fff" stroke-width="2.5"></rect>
                <circle cx="21" cy="21" r="4.4" fill="none" stroke="#fff" stroke-width="2.5"></circle>
                <circle cx="26.4" cy="15.9" r="1.5" fill="#fff"></circle>
              </svg>
            )}
            {item.kind === 'linkedin' && (
              <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                <circle cx="21" cy="21" r="21" fill="currentColor"></circle>
                <path
                  fill="#fff"
                  d="M12.6 18.3h4.3v13.5h-4.3V18.3Zm2.2-6.7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Zm5 6.7h4.1v1.9h.1c.6-1.1 2-2.3 4.2-2.3 4.5 0 5.3 2.9 5.3 6.8v7.1h-4.3v-6.4c0-1.5 0-3.5-2.1-3.5-2.2 0-2.5 1.7-2.5 3.4v6.5h-4.3V18.3Z"
                ></path>
              </svg>
            )}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="container fineprint">
    <p>&copy; All Rights Reserved New Afro 2026</p>
  </div>

  <script is:inline>
    (function () {
      document.querySelectorAll('form[data-newsletter-form]').forEach(function (form) {
        if (form.dataset.bound === '1') return;
        form.dataset.bound = '1';
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          const input = form.querySelector('input[type="email"]');
          const out = form.querySelector('[data-newsletter-msg]');
          const email = input && input.value ? String(input.value).trim() : '';
          if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
            if (out) {
              out.textContent = 'Please enter a valid email address.';
              out.hidden = false;
            }
            if (input) input.focus();
            return;
          }
          if (out) {
            out.textContent = 'Opening your email app to finish the signup.';
            out.hidden = false;
          }
          window.location.href = 'mailto:cheria@newafro.net?subject=New%20Afro%20newsletter%20signup&body=Please%20add%20' + encodeURIComponent(email) + '%20to%20the%20New%20Afro%20newsletter.';
        });
      });
    })();
  </script>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    padding-block: var(--na-s-14) var(--na-s-9);
    background: var(--na-sand);
    color: var(--na-ink);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.2fr;
    gap: var(--na-s-12);
    margin-bottom: var(--na-s-12);
  }

  .footer-col h3 {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 600;
    font-size: var(--na-fs-body);
    text-transform: none;
    letter-spacing: 0;
    color: var(--na-ink);
    margin: 0 0 var(--na-s-7);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: var(--na-s-5);
  }

  .footer-col a {
    color: var(--na-ink);
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-body);
    text-decoration: none;
    transition: color var(--na-dur-fast) var(--na-ease);
  }

  .footer-col a:hover { color: var(--na-bronze); }

  .subscribe {
    display: flex;
    flex-direction: column;
    gap: var(--na-s-4);
  }

  .subscribe input[type='email'] {
    width: 100%;
    min-height: 52px;
    box-sizing: border-box;
    background: transparent;
    border: 1px solid rgba(50, 28, 1, 0.4);
    color: var(--na-ink);
    padding: var(--na-s-5) var(--na-s-6);
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-body);
    border-radius: 0;
    outline: 0;
    transition: border-color var(--na-dur-fast) var(--na-ease);
  }

  .subscribe input::placeholder { color: rgba(50, 28, 1, 0.6); }

  .subscribe input:focus { border-color: var(--na-bronze); }

  .subscribe-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    background: var(--na-bronze);
    color: #ffffff;
    font-family: "futura-lt-w01-book", var(--na-font-headline), sans-serif;
    font-size: 18px;
    font-weight: 500;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition: background var(--na-dur-base) var(--na-ease);
  }

  .subscribe-btn:hover { background: var(--na-bronze-deep); }

  @media (max-width: 420px) {
    .subscribe-btn { width: 100%; }
  }

  .subscribe-msg {
    margin: var(--na-s-3) 0 0;
    color: var(--na-bronze-deep);
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-small);
    line-height: 1.5;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 26px;
    margin-top: var(--na-s-7);
  }

  .social-links a {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
  }

  .social-links svg {
    width: 42px;
    height: 42px;
    display: block;
    flex: none;
    shape-rendering: geometricPrecision;
  }

  .social-links a:hover {
    opacity: 0.78;
  }

  .fineprint {
    padding-top: var(--na-s-9);
    border-top: 1px solid rgba(50, 28, 1, 0.15);
    color: var(--na-ink);
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-small);
    text-align: center;
  }

  .fineprint p { margin: 0; }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--na-s-12) var(--na-s-9);
    }
    .subscribe-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--na-s-9);
    }
    .subscribe-col {
      grid-column: auto;
    }
  }
</style>
