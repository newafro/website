---
import { u } from '../lib/url';
---

<article class="contact-landing">
  <section class="contact-hero" aria-labelledby="contact-title">
    <div class="contact-hero__content">
      <h1 id="contact-title">Contact</h1>
      <p>Parcusstr. 6, 55116 Mainz</p>
      <p><a href="mailto:hello@newafro.net">hello@newafro.net</a></p>
      <ul class="contact-socials" aria-label="Social links">
        <li><a href="https://www.instagram.com/newafro" rel="me noopener">Instagram</a></li>
        <li><a href="https://www.linkedin.com/company/newafro" rel="me noopener">LinkedIn</a></li>
      </ul>
    </div>
    <form class="contact-form" data-contact-form novalidate>
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" />
      </label>
      <label>
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="3"></textarea>
      </label>
      <button type="submit">Send</button>
      <p data-contact-msg hidden></p>
    </form>
  </section>

  <script is:inline>
    (function () {
      document.querySelectorAll('form[data-contact-form]').forEach(function (form) {
        if (form.dataset.bound === '1') return;
        form.dataset.bound = '1';
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          const data = new FormData(form);
          const name = String(data.get('name') || '').trim();
          const email = String(data.get('email') || '').trim();
          const message = String(data.get('message') || '').trim();
          const out = form.querySelector('[data-contact-msg]');

          if (!email || !email.includes('@')) {
            if (out) {
              out.textContent = 'Please add your email so the team can reply.';
              out.hidden = false;
            }
            return;
          }

          const body = [
            name ? 'Name: ' + name : '',
            email ? 'Email: ' + email : '',
            '',
            message,
          ].filter(Boolean).join('\\n');

          if (out) {
            out.textContent = 'Opening your email app to send the message.';
            out.hidden = false;
          }

          window.location.href = 'mailto:hello@newafro.net?subject=New%20Afro%20website%20message&body=' + encodeURIComponent(body);
        });
      });
    })();
  </script>
</article>

<style>
  .contact-landing {
    background: var(--na-cream);
    color: var(--na-paper);
  }

  .contact-hero {
    position: relative;
    min-height: 606px;
    display: grid;
    place-items: center;
    padding: 112px 24px 96px;
    background:
      linear-gradient(rgba(35, 20, 5, 0.32), rgba(35, 20, 5, 0.38)),
      url('/uploads/about/about-hero.jpg') center 38% / cover no-repeat;
    overflow: hidden;
  }

  .contact-hero__content {
    text-align: center;
    transform: translateY(-18px);
  }

  .contact-hero h1 {
    margin: 0 0 28px;
    font-family: var(--na-font-page-display);
    font-size: clamp(54px, 5.2vw, 76px);
    font-weight: 400;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
    color: var(--na-paper);
  }

  .contact-hero p {
    margin: 0 0 8px;
    font-family: var(--na-font-body);
    font-size: 16px;
    line-height: 1.4;
  }

  .contact-hero a {
    color: inherit;
    text-decoration: none;
  }

  .contact-socials {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 18px;
    margin: 22px 0 0;
    padding: 0;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .contact-form {
    position: absolute;
    right: clamp(28px, 9vw, 140px);
    bottom: 52px;
    width: min(360px, calc(100% - 48px));
    display: grid;
    gap: 10px;
    color: var(--na-paper);
  }

  .contact-form label {
    display: grid;
    gap: 4px;
    font-family: var(--na-font-body);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgba(255, 249, 235, 0.72);
    border-radius: 0;
    background: transparent;
    color: var(--na-paper);
    font: inherit;
    min-height: 34px;
    outline: 0;
  }

  .contact-form button {
    justify-self: start;
    margin-top: 8px;
    padding: 8px 22px;
    border: 1px solid rgba(255, 249, 235, 0.8);
    background: transparent;
    color: var(--na-paper);
    font-family: var(--na-font-body);
    font-size: 14px;
    cursor: pointer;
  }

  .contact-form [data-contact-msg] {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.35;
    text-transform: none;
    letter-spacing: 0;
  }

  @media (max-width: 760px) {
    .contact-hero {
      min-height: 640px;
      align-items: start;
      padding-top: 128px;
    }

    .contact-hero__content {
      transform: none;
    }

    .contact-form {
      position: static;
      margin-top: 48px;
    }
  }
</style>
