---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';

const heroMark      = u('/uploads/agency/agency-mark@4x.png');
const structuralImg = u('/uploads/agency/02-d5693e_86b37a23b8e54299b3b66a0a83993602-mv2.jpg');
const roleImg       = u('/uploads/agency/04-e7ed0d_a3c5ac89d66d468e843ae9e0d93741b5-mv2.jpg');
const clientsImg    = u('/uploads/agency/06-d5693e_0489f0c3dff341d99a33b531ac7b5cae-mv2.jpg');

const servicePillars = [
  {
    title: 'Curatorial strategy',
    body: 'We turn a cultural ambition into a theme, artist selection, exhibition format and visitor journey.',
  },
  {
    title: 'Artist and partner access',
    body: 'We connect artists, institutions, brands and local hosts through relationships built across Africa and Europe.',
  },
  {
    title: 'Public programming',
    body: 'We shape openings, talks, showrooms and encounters so the work can be understood, discussed and remembered.',
  },
  {
    title: 'Market-facing storytelling',
    body: 'We make the project legible for audiences, partners and funders without flattening the cultural context.',
  },
];

const clientSegments = [
  {
    title: 'Institutions and galleries',
    body: 'For cultural teams that need a credible bridge to African and diasporic artistic perspectives: concept, artist selection, programming and partnership architecture.',
  },
  {
    title: 'Artists and cultural entrepreneurs',
    body: 'For artists who need positioning, presentation formats and the right context to be seen by audiences, collaborators and collectors.',
  },
  {
    title: 'Brands and creative businesses',
    body: 'For brands expanding between Africa and Europe that need cultural fluency, community access and a story people can trust.',
  },
];

const selectedWork = [
  {
    tag: 'Institutional exhibition / Mainz',
    title: 'Naza Po Tozali... On The Way To Find Myself.',
    meta: 'Institut français Mainz',
    body: 'A photographic exhibition with Jean-Baptiste Joire, Benga Mavinga and Eveline Soum, shaped around identity, belonging and the question of self.',
    href: u('/event-details-registration/nazo-po-tozali-on-the-way-to-find-myself'),
  },
  {
    tag: 'Gallery exhibition / Cotonou',
    title: 'Héritage... Mémoires en Mouvement?',
    meta: 'Galerie Zato Benin',
    body: 'The first stop outside Europe for the itinerant heritage project, bringing Nuits Balnéaires and Tobi Onabolu into dialogue around memory and movement.',
    href: u('/event-details-registration/heritage-memoires-en-mouvements'),
  },
  {
    tag: 'Institutional collaboration / Mainz',
    title: 'La Teranga en Couleur',
    meta: 'Institut Français Mainz and Part Mainz',
    body: 'A Senegal-focused exhibition for la Francophonie, curated across photography, film, fashion and visual culture.',
    href: u('/event-details-registration/la-teranga-en-couleur'),
  },
  {
    tag: 'Artist presentation / Mainz',
    title: 'Rencontre',
    meta: 'Benjamin Abana and Francel Aris Dagbeto',
    body: 'A three-day exhibition format with vernissage, artist exchange, audience participation and live painting.',
    href: u('/event-details-registration/rencontre-begegnung'),
  },
];
---

<BaseLayout
  title="The Agency — New Afro"
  description="New Afro operates as a strategic creative agency positioning cultural entrepreneurs and creative brands seeking to expand between African and European markets."
>
  <article class="agency-page">
    <header class="page-header">
      <div class="container-narrow">
        <img
          class="page-eyebrow-mark agency-hero-mark"
          src={heroMark}
          alt="New Afro"
          width="61"
          height="70"
          loading="eager"
          decoding="async"
        />
        <h1 class="display-page">THE AGENCY</h1>
        <p class="agency-deck">
          We build cultural projects between Africa and Europe: curatorial
          concepts, artist selection, public programming and market-facing
          storytelling for institutions, galleries, brands and creative
          entrepreneurs.
        </p>
      </div>
    </header>

    <section class="agency-pillar-strip" aria-label="Agency services">
      <div class="container agency-pillar-grid">
        {servicePillars.map((pillar) => (
          <article>
            <h2>{pillar.title}</h2>
            <p>{pillar.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section spread spread--left">
      <div class="container spread-grid">
        <figure class="spread-media">
          <img
            src={structuralImg}
            alt="VAUX — L’Artiste, by New Afro"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="spread-caption">VAUX</figcaption>
        </figure>
        <div class="spread-copy">
          <h2>THE STRUCTURAL GAP</h2>
          <p class="lede">
            A strong cultural project needs more than visibility. It needs
            context, trust, and a format people can enter.
          </p>
          <p>
            Creative entrepreneurs from the African continent and its diaspora
            often encounter structural barriers when entering European markets:
            limited access, institutional opacity, weak positioning frameworks,
            and a lack of trusted intermediaries capable of translating
            cultural and strategic value.
          </p>
          <p>
            At the same time, European creative entrepreneurs and institutions
            seeking to engage African markets frequently struggle with
            contextual understanding, cultural fluency, and the ability to
            build partnerships that are credible, respectful, and sustainable.
          </p>
          <p>
            New Afro works in that space. We translate ambition into curatorial
            structure, shape the public story around the work, and connect the
            right artists, partners and audiences around a shared cultural
            context.
          </p>
          <p class="coda">
            The issue is not talent.<br />
            It is navigation, positioning, and trust.
          </p>
        </div>
      </div>
    </section>

    <section class="section role-section">
      <div class="container role-grid">
        <div class="role-copy">
          <h2>OUR ROLE</h2>
          <p class="lede">
            We operate at the intersection of strategy, culture, and market
            intelligence.
          </p>
          <p>
            We design cross-continental positioning and expansion strategies
            for creative entrepreneurs, companies, and institutions operating
            between Africa and Europe. Our work integrates consulting,
            management advisory, and market-entry architecture grounded in the
            social, cultural, and economic realities of both regions.
          </p>
          <p>
            Our authority is rooted in lived experience: years of being based
            between Africa and Europe, initiating and producing cultural
            projects, and building long-term relationships across countries
            on both continents. This continuous presence allows us to
            understand institutional ecosystems, informal networks, and the
            unspoken codes that shape opportunity.
          </p>
          <p>
            We act as cultural translators and strategic intermediaries,
            structuring clarity, alignment, and durable partnerships that
            extend beyond symbolic collaboration toward measurable, long-term
            growth.
          </p>
        </div>
        <figure class="role-media">
          <img
            src={roleImg}
            alt="Lyanell x Heels Bleed — New Afro project"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="spread-caption spread-caption--bottom">LYANELL X<br />HEELS BLEED</figcaption>
        </figure>
      </div>
    </section>

    <section class="section clients-section">
      <div class="container clients-grid">
        <figure class="clients-media">
          <img
            src={clientsImg}
            alt="New Afro clients — cross-market engagement"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="spread-caption">VAUX</figcaption>
        </figure>
        <div class="clients-copy">
          <h2>OUR CLIENTS</h2>
          <p class="lede">
            We work with people and organisations who need cultural credibility,
            artist access and a project structure that can move in public.
          </p>
          <div class="client-cards" aria-label="Client groups">
            {clientSegments.map((segment) => (
              <article class="client-card">
                <h3>{segment.title}</h3>
                <p>{segment.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section proof-section" id="selected-work">
      <div class="container proof-inner">
        <header class="proof-heading">
          <h2>SELECTED WORK</h2>
          <p>
            The clearest proof of the agency is the work already in motion:
            exhibitions, public programs and partnerships that gave artists a
            frame and gave audiences a way in.
          </p>
        </header>
        <div class="proof-grid">
          {selectedWork.map((item) => (
            <article class="proof-card">
              <p class="proof-card__tag">{item.tag}</p>
              <h3>{item.title}</h3>
              <p class="proof-card__meta">{item.meta}</p>
              <p>{item.body}</p>
              <a href={item.href}>View work</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section cta-section" id="agency-contact">
      <div class="container-narrow cta-inner">
        <h2>LET’S WORK TOGETHER</h2>
        <p class="cta-line">Bring us in when the project needs cultural clarity, not just promotion.</p>
        <p>Tell us what you are trying to build, who it should reach, and where the bridge feels missing.</p>
        <form class="agency-contact-form" data-agency-contact-form novalidate>
          <div class="field-row">
            <label>
              <span>Name</span>
              <input name="name" type="text" autocomplete="name" required />
            </label>
            <label>
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
          </div>
          <label>
            <span>Organisation</span>
            <input name="organisation" type="text" autocomplete="organization" />
          </label>
          <label>
            <span>What are you looking for?</span>
            <select name="interest" required>
              <option value="">Select one</option>
              <option value="Agency services">Agency services</option>
              <option value="Institutional partnership">Institutional partnership</option>
              <option value="Gallery collaboration">Gallery collaboration</option>
              <option value="Brand collaboration">Brand collaboration</option>
              <option value="Other inquiry">Other inquiry</option>
            </select>
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="6" required></textarea>
          </label>
          <button type="submit">Send inquiry</button>
          <p class="form-msg" data-agency-contact-msg hidden></p>
        </form>
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      document.querySelectorAll('form[data-agency-contact-form]').forEach(function (form) {
        if (form.dataset.bound === '1') return;
        form.dataset.bound = '1';
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          const data = new FormData(form);
          const name = String(data.get('name') || '').trim();
          const email = String(data.get('email') || '').trim();
          const interest = String(data.get('interest') || '').trim();
          const message = String(data.get('message') || '').trim();
          const out = form.querySelector('[data-agency-contact-msg]');
          if (!name || !email || !interest || !message || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
            if (out) {
              out.textContent = 'Please fill in name, email, inquiry type and message.';
              out.hidden = false;
            }
            return;
          }
          const organisation = String(data.get('organisation') || '').trim();
          const body = [
            'Name: ' + name,
            'Email: ' + email,
            organisation ? 'Organisation: ' + organisation : 'Organisation:',
            'Inquiry type: ' + interest,
            '',
            message,
          ].join('\n');
          if (out) {
            out.textContent = 'Opening your email app to send the inquiry.';
            out.hidden = false;
          }
          window.location.href = 'mailto:hello@newafro.net?subject=' + encodeURIComponent('New Afro agency inquiry - ' + interest) + '&body=' + encodeURIComponent(body);
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .agency-page {
    background: #fff;
    color: var(--na-ink);
  }

  .page-header {
    padding-block: clamp(var(--na-s-12), 8vw, var(--na-s-16)) var(--na-s-12);
    text-align: center;
  }

  .page-header .container-narrow {
    max-width: min(100%, 1320px);
  }

  .page-header h1.display-page {
    display: inline-block;
    margin: 0 auto var(--na-s-7);
    max-width: calc(100vw - 48px);
    text-align: center;
    white-space: nowrap;
    font-weight: 500;
    letter-spacing: 0;
    font-size: clamp(72px, 9vw, 148px);
  }

  .agency-deck {
    font-family: var(--na-font-body);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.5;
    color: var(--na-ink);
    margin: 0 auto;
    max-width: 60ch;
  }

  .agency-hero-mark {
    display: block;
    margin: 0 auto var(--na-s-8);
    width: clamp(42px, 4vw, 56px);
    height: auto;
    object-fit: contain;
  }

  .agency-pillar-strip {
    border-top: 1px solid rgba(50, 28, 1, 0.1);
    border-bottom: 1px solid rgba(50, 28, 1, 0.1);
    background: var(--na-sand);
  }

  .agency-pillar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: none;
    padding: 0;
  }

  .agency-pillar-grid article {
    min-height: 220px;
    padding: clamp(28px, 4vw, 54px) clamp(22px, 3vw, 42px);
    border-right: 1px solid rgba(50, 28, 1, 0.12);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .agency-pillar-grid article:last-child {
    border-right: 0;
  }

  .agency-pillar-grid h2 {
    font-family: var(--na-font-headline);
    font-size: clamp(17px, 1.5vw, 24px);
    line-height: 1.12;
    margin: 0 0 var(--na-s-4);
    text-transform: uppercase;
  }

  .agency-pillar-grid p {
    font-family: var(--na-font-body);
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.45;
    margin: 0;
    max-width: 34ch;
  }

  .section { padding-block: 0; }

  .spread-grid,
  .role-grid,
  .clients-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    width: 100%;
    max-width: none;
    padding-inline: 0;
  }

  .spread-media,
  .role-media,
  .clients-media {
    position: relative;
    margin: 0;
    min-height: clamp(420px, 50vw, 700px);
    overflow: hidden;
    background: var(--na-clay);
  }

  .spread-media img,
  .role-media img,
  .clients-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .spread-caption {
    position: absolute;
    right: var(--na-s-9);
    bottom: var(--na-s-9);
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(34px, 4vw, 64px);
    line-height: 1;
    color: #d8593c;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 14px rgba(0,0,0,0.25);
    pointer-events: none;
  }

  .spread-caption--bottom {
    left: 50%;
    right: auto;
    bottom: var(--na-s-9);
    transform: translateX(-50%);
    text-align: center;
    color: #fff;
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(28px, 3.8vw, 56px);
    line-height: 1.05;
    letter-spacing: 0.04em;
  }

  .spread-copy,
  .role-copy,
  .clients-copy,
  .cta-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: clamp(420px, 50vw, 700px);
    padding: clamp(var(--na-s-9), 5vw, var(--na-s-14));
    text-align: center;
  }

  .spread-copy h2,
  .role-copy h2,
  .clients-copy h2,
  .cta-inner h2 {
    font-family: var(--na-font-headline);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1.15;
    color: var(--na-ink);
    margin: 0 0 var(--na-s-7);
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .spread-copy p,
  .role-copy p,
  .clients-copy p,
  .cta-inner p {
    font-family: var(--na-font-body);
    font-size: clamp(14px, 1.1vw, 17px);
    line-height: 1.45;
    color: var(--na-ink);
    margin: 0 0 var(--na-s-5);
    max-width: 46ch;
  }

  .lede {
    font-family: var(--na-font-body);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 18px) !important;
    line-height: 1.45 !important;
    color: var(--na-ink);
    margin-bottom: var(--na-s-7) !important;
  }

  .coda {
    font-family: var(--na-font-body);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(15px, 1.2vw, 18px) !important;
    line-height: 1.45 !important;
    color: var(--na-ink);
    margin-top: var(--na-s-7);
  }

  .client-cards {
    width: min(100%, 560px);
    display: grid;
    gap: var(--na-s-4);
    margin-top: var(--na-s-3);
  }

  .client-card {
    border: 1px solid rgba(50, 28, 1, 0.22);
    background: rgba(255, 249, 235, 0.6);
    padding: clamp(18px, 2vw, 24px);
    text-align: left;
  }

  .client-card h3 {
    font-family: var(--na-font-headline);
    font-size: clamp(18px, 1.45vw, 24px);
    line-height: 1.12;
    margin: 0 0 var(--na-s-3);
    color: var(--na-ink);
  }

  .client-card p {
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.45;
    margin: 0;
    max-width: none;
    text-align: left;
  }

  .proof-section {
    background: #2d1804;
    color: var(--na-cream-warm);
    padding-block: clamp(var(--na-s-11), 8vw, var(--na-s-15));
  }

  .proof-inner {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .proof-heading {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(var(--na-s-7), 5vw, var(--na-s-12));
    align-items: end;
    margin-bottom: clamp(var(--na-s-8), 6vw, var(--na-s-12));
  }

  .proof-heading h2 {
    font-family: var(--na-font-headline);
    font-size: clamp(30px, 5vw, 72px);
    line-height: 0.95;
    margin: 0;
    color: var(--na-cream-warm);
  }

  .proof-heading p {
    font-family: var(--na-font-body);
    font-size: clamp(15px, 1.35vw, 20px);
    line-height: 1.45;
    margin: 0;
    max-width: 58ch;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 249, 235, 0.2);
    border: 1px solid rgba(255, 249, 235, 0.2);
  }

  .proof-card {
    min-height: 360px;
    padding: clamp(24px, 3vw, 36px);
    background: #2d1804;
    display: flex;
    flex-direction: column;
  }

  .proof-card__tag,
  .proof-card__meta {
    font-family: var(--na-font-ui);
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 249, 235, 0.68);
    margin: 0 0 var(--na-s-4);
  }

  .proof-card h3 {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(28px, 2.8vw, 42px);
    line-height: 0.98;
    color: var(--na-cream-warm);
    margin: 0 0 var(--na-s-4);
  }

  .proof-card p {
    font-family: var(--na-font-body);
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.5;
    margin: 0 0 var(--na-s-5);
    color: rgba(255, 249, 235, 0.88);
  }

  .proof-card a {
    margin-top: auto;
    color: var(--na-cream-warm);
    font-family: var(--na-font-ui);
    font-size: 14px;
    font-weight: 700;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .cta-section {
    text-align: center;
    padding-block: 0;
    background: var(--na-sand);
  }

  .cta-inner h2 {
    text-align: center;
    margin-bottom: var(--na-s-7);
  }

  .cta-line {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 2vw, 26px) !important;
    margin: 0 0 var(--na-s-7) !important;
  }

  .agency-contact-form {
    width: min(100%, 680px);
    margin-top: var(--na-s-6);
    display: grid;
    gap: var(--na-s-5);
    text-align: left;
  }

  .agency-contact-form .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--na-s-5);
  }

  .agency-contact-form label {
    display: grid;
    gap: var(--na-s-3);
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-small);
    color: var(--na-ink);
  }

  .agency-contact-form span {
    font-weight: 600;
  }

  .agency-contact-form input,
  .agency-contact-form select,
  .agency-contact-form textarea {
    width: 100%;
    min-height: 52px;
    border: 1px solid rgba(50, 28, 1, 0.38);
    border-radius: 0;
    background: rgba(255, 249, 235, 0.82);
    color: var(--na-ink);
    padding: 13px 15px;
    font: 16px/1.4 var(--na-font-ui);
    outline: 0;
    transition: border-color var(--na-dur-fast) var(--na-ease), background var(--na-dur-fast) var(--na-ease);
  }

  .agency-contact-form textarea {
    min-height: 150px;
    resize: vertical;
  }

  .agency-contact-form input:focus,
  .agency-contact-form select:focus,
  .agency-contact-form textarea:focus {
    border-color: var(--na-bronze);
    background: var(--na-cream-warm);
  }

  .agency-contact-form button {
    min-height: 54px;
    width: 100%;
    background: var(--na-bronze);
    color: #fff;
    border: 0;
    border-radius: 0;
    font-family: var(--na-font-ui);
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--na-dur-base) var(--na-ease);
  }

  .agency-contact-form button:hover {
    background: var(--na-bronze-deep);
  }

  .agency-contact-form .form-msg {
    margin: 0;
    max-width: none;
    color: var(--na-bronze-deep);
    font-family: var(--na-font-ui);
    font-size: var(--na-fs-small);
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 1000px) {
    .agency-pillar-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .agency-pillar-grid article {
      border-bottom: 1px solid rgba(50, 28, 1, 0.12);
    }

    .agency-pillar-grid article:nth-child(2n) {
