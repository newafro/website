---
import { u } from '../lib/url';

const nav = [
  { href: '/', label: 'HOME' },
  { href: '/about', label: 'THE AGENCY' },
  { href: '/community', label: 'COMMUNITY' },
  { href: '/archive', label: 'THE ARCHIVE' },
  { href: '/projects', label: 'PROJECTS' },
  { href: '/events', label: 'EVENTS' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const currentPath = Astro.url.pathname.replace(new RegExp(`^${base}`), '').replace(/\/$/, '') || '/';
---

<header class="site-header" data-tone="paper">
  <div class="container header-inner">
    <a class="brand" href={u('/')} aria-label="New Afro home">
      <img
        src={u('/logo.png')}
        srcset={`${u('/logo.png')} 1x, ${u('/logo@2x.png')} 2x`}
        alt=""
        width="56"
        height="45"
        loading="eager"
        decoding="async"
      />
      <span class="brand__mark">New Afro</span>
    </a>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul>
        {nav.map(item => (
          <li>
            <a
              href={u(item.href)}
              aria-current={currentPath === item.href.replace(/\/$/, '') ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" type="button">
      <span class="visually-hidden">Toggle menu</span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-locked', open);
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });
    nav.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      // Click on the ::before backdrop region — target is the nav itself
      if (target === nav) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--na-paper);
    border-bottom: 1px solid rgba(50, 28, 1, 0.1);
    backdrop-filter: saturate(180%) blur(8px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--na-s-9);
    padding-block: var(--na-s-7);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--na-s-5);
    color: var(--na-ink);
    text-decoration: none;
  }

  .brand img {
    height: 45px;
    width: auto;
    display: block;
  }

  .brand__mark {
    font-family: var(--na-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 28px;
    letter-spacing: -0.01em;
  }

  @media (max-width: 480px) {
    .brand__mark { display: none; }
  }

  /* Mobile header: white band with solid brown square hamburger,
     logo + wordmark hidden — matches newafro.net at ≤900px */
  @media (max-width: 900px) {
    .header-inner {
      padding-inline: 0 !important;
      padding-block: 0;
      gap: 0;
      min-height: 120px;
      max-width: 100%;
    }

    .brand img,
    .brand__mark {
      display: none;
    }

    .brand {
      flex: 1;
      min-height: 64px;
    }
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--na-s-9);
    align-items: center;
  }

  .nav a {
    font-family: var(--na-font-headline);
    font-size: var(--na-fs-menu);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    color: var(--na-ink);
    text-decoration: none;
    padding-block: var(--na-s-3);
    transition: color var(--na-dur-fast) var(--na-ease);
  }

  .nav a:hover { color: var(--na-bronze); }

  .nav a[aria-current='page'] {
    color: var(--na-bronze);
    border-bottom: 1px solid var(--na-bronze);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    z-index: 60;
    position: relative;
  }

  .nav-toggle .bar {
    display: block;
    height: 1.5px;
    width: 22px;
    margin-inline: auto;
    background: var(--na-ink);
    transition: transform var(--na-dur-base) var(--na-ease),
                opacity var(--na-dur-fast) var(--na-ease),
                background-color var(--na-dur-fast) var(--na-ease);
  }

  .nav-toggle[aria-expanded='true'] .bar { background: var(--na-cream-warm); }
  .nav-toggle[aria-expanded='true'] .bar:nth-child(2) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .bar:nth-child(3) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .bar:nth-child(4) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 64px;
      height: 64px;
      background: var(--na-bronze-deep);
      border-radius: 0;
      flex-shrink: 0;
      position: fixed;
      top: 0;
      right: 0;
      z-index: 60;
    }

    .nav-toggle .bar {
      height: 3px;
      width: 28px;
      background: var(--na-paper);
    }

    .nav-toggle[aria-expanded='true'] {
      background: #000000;
      position: fixed;
      top: 0;
      right: 0;
    }

    .nav-toggle[aria-expanded='true'] .bar { background: #FFFFFF; }

    .nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 78%;
      background: var(--na-ink);
      transform: translateX(100%);
      transition: transform var(--na-dur-base) var(--na-ease);
      z-index: 55;
      display: flex;
      overflow-y: auto;
    }

    .nav::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 22%;
      background: rgba(50, 28, 1, 0.4);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--na-dur-base) var(--na-ease);
    }

    .nav.is-open {
      transform: translateX(0);
    }

    .nav.is-open::before {
      opacity: 1;
      pointer-events: auto;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--na-s-12) var(--na-s-9) var(--na-s-9);
      width: 100%;
      flex-wrap: nowrap;
    }

    .nav li {
      border-bottom: 0;
      width: 100%;
    }

    .nav a {
      display: block;
      width: 100%;
      text-align: left;
      padding: var(--na-s-7) var(--na-s-9);
      font-family: var(--na-font-display);
      font-style: italic;
      font-weight: 300;
      font-size: clamp(28px, 6vw, 34px);
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--na-cream-warm);
    }

    .nav a:hover {
      color: var(--na-cream-warm);
      border-bottom: 0;
    }

    .nav a[aria-current='page'] {
      color: var(--na-cream-warm);
      background: rgba(255, 249, 235, 0.18);
      border-bottom: 0;
    }
  }

  body.nav-locked { overflow: hidden; }
</style>
