---
import { u } from '../lib/url';

const nav = [
  { href: '/', label: 'HOME' },
  { href: '/general-1', label: 'THE AGENCY' },
  { href: '/community', label: 'COMMUNITY' },
  { href: '/behind-the-scenes', label: 'THE ARCHIVE' },
  { href: '/single-project', label: 'PROJECTS' },
  { href: '/events', label: 'EVENTS' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href={u('/')} aria-label="New Afro home">
      <img src={u('/logo.png')} alt="" width="48" height="39" loading="eager" decoding="async" />
    </a>
  </div>

  <button
    class="nav-toggle"
    aria-controls="primary-nav"
    aria-expanded="false"
    type="button"
  >
    <span class="visually-hidden">Toggle menu</span>
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
  </button>

  <nav id="primary-nav" class="nav-panel" aria-label="Primary">
    <div class="nav-panel__inner">
      <ul>
        {nav.map(item => (
          <li><a href={u(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-locked', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if (event.target === nav || event.target instanceof HTMLAnchorElement) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 80;
    background: #fff;
    color: #000;
  }

  .header-inner {
    width: 100%;
    max-width: 1040px;
    height: 92px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .brand-link {
    display: none;
  }

  .nav-toggle {
    width: 48px;
    height: 48px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    background: transparent;
    color: #000;
    cursor: pointer;
    position: fixed;
    top: 23px;
    left: 24px;
    flex: 0 0 48px;
    z-index: 90;
    transition: color 180ms ease;
  }

  @media (min-width: 1200px) {
    .nav-toggle {
      left: auto;
      right: 24px;
    }
  }

  .bar {
    width: 39px;
    height: 4px;
    display: block;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .nav-toggle[aria-expanded="true"] {
    top: clamp(28px, 6.8vw, 70px);
    left: clamp(28px, 19vw, 400px);
    right: auto;
    color: rgba(255, 249, 235, 0.92);
  }

  .nav-toggle[aria-expanded="true"] .bar {
    width: 34px;
    height: 2px;
  }

  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) {
    transform: translateY(10px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .bar:nth-child(4) {
    transform: translateY(-10px) rotate(-45deg);
  }

  .nav-panel {
    position: fixed;
    inset: 0;
    z-index: 70;
    background:
      radial-gradient(circle at 74% 12%, rgba(153, 105, 47, 0.95), transparent 46%),
      linear-gradient(105deg, #1f1203 0%, #2d1804 28%, #58340f 58%, #8a622e 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .nav-panel.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-panel__inner {
    min-height: 100%;
    display: flex;
    align-items: center;
    padding: clamp(104px, 14vw, 180px) 24px clamp(64px, 9vw, 120px);
  }

  .nav-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(28px, 4.6vw, 56px);
    text-align: left;
    margin-left: clamp(28px, 19vw, 400px);
  }

  .nav-panel a {
    font-family: var(--na-font-display);
    font-size: clamp(42px, 4.2vw, 58px);
    font-style: italic;
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: 0;
    color: rgba(255, 249, 235, 0.95);
    text-decoration: none;
  }

  .nav-panel a:hover {
    color: #fff;
  }

  @media (max-width: 760px) {
    .nav-toggle {
      left: 22px;
      right: auto;
    }

    .nav-toggle[aria-expanded="true"] {
      top: 26px;
      left: 22px;
    }

    .nav-panel {
      background:
        radial-gradient(circle at 92% 8%, rgba(126, 88, 42, 0.82), transparent 50%),
        linear-gradient(130deg, #211204 0%, #351b05 58%, #6b4617 100%);
    }

    .nav-panel__inner {
      align-items: center;
      padding: 96px 28px 56px;
    }

    .nav-panel ul {
      margin-left: 0;
      gap: 26px;
    }

    .nav-panel a {
      font-size: clamp(38px, 15vw, 56px);
    }
  }

  :global(.nav-locked) {
    overflow: hidden;
  }
</style>
