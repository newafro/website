---
import { u } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'image' | 'paper' | 'cream' | 'ink';
  size?: 'xxl' | 'xl' | 'l';
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt = '',
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  variant = image ? 'image' : 'paper',
  size = image ? 'xxl' : 'xl',
} = Astro.props;

const tone = variant === 'image' || variant === 'ink' ? 'ink' : variant;
const heroSrc = image ? (image.startsWith('/') && !image.startsWith('//') ? u(image) : image) : undefined;
---

<section class={`hero hero--${variant} hero--size-${size}`} data-tone={tone}>
  {heroSrc && (
    <div class="hero-media" aria-hidden="true">
      <img src={heroSrc} alt={imageAlt} loading="eager" decoding="async" />
      <div class="hero-scrim"></div>
    </div>
  )}

  <div class="container hero-inner">
    {eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
    <h1 class={`display display-${size}`}>{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {(ctaLabel || secondaryLabel) && (
      <div class="hero-cta">
        {ctaLabel && ctaHref && (
          <a class="na-btn" href={ctaHref}>{ctaLabel}</a>
        )}
        {secondaryLabel && secondaryHref && (
          <a class="na-btn na-btn--ghost" href={secondaryHref}>{secondaryLabel}</a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(var(--na-s-16), 14vw, var(--na-s-20));
  }

  .hero--paper { background: var(--na-paper); color: var(--na-ink); }
  .hero--cream { background: var(--na-sand-light); color: var(--na-ink); }
  .hero--ink   { background: var(--na-ink);        color: var(--na-paper); }

  .hero--image {
    background: var(--na-ink);
    color: var(--na-paper);
    min-height: clamp(540px, 80vh, 760px);
    display: flex;
    align-items: flex-end;
    padding-block: clamp(var(--na-s-20), 18vw, 200px) var(--na-s-14);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.6) 100%),
      linear-gradient(0deg, rgba(0,0,0,0.35), rgba(0,0,0,0.35));
  }

  .hero-inner {
    position: relative;
    max-width: 960px;
  }

  .hero-eyebrow {
    color: var(--na-bronze-hi);
    margin: 0 0 var(--na-s-7);
    font-family: var(--na-font-headline);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--na-tracking-caps);
    font-size: var(--na-fs-small);
  }

  .hero--paper .hero-eyebrow,
  .hero--cream .hero-eyebrow { color: var(--na-bronze-deep); }

  .hero h1 {
    margin: 0 0 var(--na-s-9);
    color: inherit;
  }

  .hero-subtitle {
    font-family: var(--na-font-body);
    font-size: clamp(var(--na-fs-lead), 1.6vw, 22px);
    line-height: 1.5;
    max-width: 56ch;
    margin: 0 0 var(--na-s-12);
    color: inherit;
    opacity: 0.92;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--na-s-6);
  }

  .hero-cta :global(.na-btn) {
    border-radius: 0;
    text-transform: none;
    letter-spacing: 0;
    padding: 12px 28px;
  }

  @media (max-width: 640px) {
    .hero--image { min-height: 60vh; }
    .hero-cta :global(.na-btn) { padding-inline: var(--na-s-7); }
  }
</style>
