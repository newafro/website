---

<section class="archive-hero" aria-labelledby="archive-title">
  <video
    class="archive-hero__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={u('/uploads/video/archive-hero-poster.png')}
    aria-hidden="true"
  >
    <source src={u('/uploads/video/archive-hero.mp4')} type="video/mp4" />
  </video>
  <div class="archive-hero__scrim" aria-hidden="true"></div>
  <div class="archive-hero__inner">
    <h1 id="archive-title">THE ARCHIVE</h1>
    <p class="archive-hero__lead">Step into our creative world!</p>
    <p>
      A living timeline of exhibitions, projects, collaborations, and field
      notes from New Afro.
    </p>
  </div>
</section>

<section class="archive-timeline" aria-label="New Afro archive timeline">
  <ol class="project-list">
    {projects.map((project) => (
      <li class="archive-project">
        <div class="project-meta">
          <span>{project.kicker}</span>
          <strong>{project.date}</strong>
        </div>
        <div class="project-body">
          <header class="project-title">
            <h2>{project.title}</h2>
            <p>{project.venue}</p>
          </header>
          <div class="project-carousel" data-archive-carousel>
            <button class="project-carousel__button project-carousel__button--prev" type="button" aria-label={`Previous images for ${project.title}`}></button>
            <div class="project-gallery" tabindex="0" aria-label={`${project.title} image carousel`}>
              {project.media.map(item => (
                <figure class={item.fit === 'contain' ? 'gallery-item gallery-item--contain' : 'gallery-item'}>
                  <img src={u(item.src)} alt={item.alt} loading="eager" decoding="async" />
                </figure>
              ))}
            </div>
            <button class="project-carousel__button project-carousel__button--next" type="button" aria-label={`Next images for ${project.title}`}></button>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  const setupArchiveCarousels = () => {
    document.querySelectorAll('[data-archive-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('.project-gallery');
      const previous = carousel.querySelector('.project-carousel__button--prev');
      const next = carousel.querySelector('.project-carousel__button--next');
      const firstSlide = track?.querySelector('.gallery-item');

      if (!(track instanceof HTMLElement) || !(firstSlide instanceof HTMLElement)) {
        return;
      }

      const scrollOneSlide = (direction) => {
        track.scrollBy({
          left: direction * firstSlide.getBoundingClientRect().width,
          behavior: 'smooth',
        });
      };

      previous?.addEventListener('click', () => scrollOneSlide(-1));
      next?.addEventListener('click', () => scrollOneSlide(1));
    });
  };

  setupArchiveCarousels();
  document.addEventListener('astro:page-load', setupArchiveCarousels);
</script>

<style>
  .archive-hero {
    position: relative;
    min-height: clamp(280px, 34vh, 420px);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #2a1705;
    color: var(--na-cream-warm);
    text-align: center;
  }

  .archive-hero__video,
  .archive-hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .archive-hero__video {
    object-fit: cover;
    z-index: -2;
  }

  .archive-hero__scrim {
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(23, 11, 2, 0.5), rgba(23, 11, 2, 0.84)),
      rgba(23, 11, 2, 0.28);
  }

  .archive-hero__inner {
    width: min(760px, calc(100% - 48px));
    padding-top: 22px;
  }

  .archive-hero h1 {
    font-family: var(--na-font-page-display);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(52px, 9vw, 118px);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--na-cream-warm);
    margin: 0 0 clamp(32px, 5vw, 62px);
  }

  .archive-hero__lead {
    margin: 0 auto var(--na-s-4);
    font-family: var(--na-font-display);
    font-style: italic;
    font-size: clamp(26px, 4vw, 42px);
    line-height: 1.05;
    color: var(--na-cream-warm);
  }

  .archive-hero p:not(.archive-hero__lead) {
    margin: 0 auto;
    max-width: 54ch;
    color: rgba(255, 249, 235, 0.82);
    font-family: var(--na-font-body);
    font-size: 14px;
    line-height: 1.55;
  }

  .archive-timeline {
    background: #1f1000;
    color: var(--na-cream-warm);
    min-height: 100vh;
    padding: 0 0 clamp(54px, 7vw, 92px);
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .archive-project {
    display: block;
    border-top: 1px solid rgba(255, 249, 235, 0.08);
  }

  .project-meta {
    position: static;
    padding: clamp(18px, 2.2vw, 30px) 20px 0;
    color: rgba(255, 249, 235, 0.82);
    font-family: var(--na-font-sans);
    font-size: clamp(13px, 1.2vw, 17px);
    line-height: 1.3;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
    background: #2a1705;
  }

  .project-meta strong {
    display: block;
    margin-top: 4px;
    color: var(--na-cream-warm);
    font-size: clamp(13px, 1.2vw, 16px);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-body {
    min-width: 0;
    padding-right: 0;
  }

  .project-title {
    text-align: center;
    margin: 0;
    padding: 8px 20px clamp(18px, 2.2vw, 30px);
    background: #2a1705;
  }

  .project-title h2 {
    margin: 0 0 4px;
    font-family: var(--na-font-display);
    font-size: clamp(18px, 2.3vw, 34px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: 0;
    color: var(--na-cream-warm);
    overflow-wrap: anywhere;
  }

  .project-title p {
    margin: 0;
    max-width: none;
    font-family: var(--na-font-sans);
    font-size: clamp(12px, 1vw, 15px);
    line-height: 1.2;
    color: rgba(255, 249, 235, 0.82);
  }

  .project-carousel {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    background: #140900;
  }

  .project-gallery {
    display: flex;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    background: #140900;
  }

  .project-gallery::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    flex: 0 0 calc(100vw / 3);
    margin: 0;
    min-width: 0;
    height: clamp(430px, 36vw, 740px);
    overflow: hidden;
    background: #140900;
    scroll-snap-align: start;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #140900;
  }

  .gallery-item--contain img {
    object-fit: contain;
    padding: clamp(8px, 1vw, 18px);
  }

  .project-carousel__button {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: clamp(42px, 4.2vw, 70px);
    height: clamp(58px, 7vw, 96px);
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgba(255, 249, 235, 0.95);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .project-carousel__button::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(24px, 2.6vw, 42px);
    height: clamp(24px, 2.6vw, 42px);
    border-top: 3px solid currentColor;
    border-left: 3px solid currentColor;
  }

  .project-carousel__button--prev {
    left: clamp(8px, 1.8vw, 30px);
  }

  .project-carousel__button--prev::before {
    transform: translate(-35%, -50%) rotate(-45deg);
  }

  .project-carousel__button--next {
    right: clamp(8px, 1.8vw, 30px);
  }

  .project-carousel__button--next::before {
    transform: translate(-65%, -50%) rotate(135deg);
  }

  .project-carousel__button:focus-visible {
    outline: 2px solid var(--na-cream-warm);
    outline-offset: -8px;
  }

  @media (max-width: 900px) {
    .archive-hero {
      min-height: 300px;
    }

    .archive-hero h1 {
      font-size: clamp(48px, 15vw, 72px);
      margin-bottom: 44px;
    }

    .project-meta {
      width: 100%;
      margin: 0;
      padding-inline: 20px;
    }

    .project-meta strong {
      margin-top: 4px;
      white-space: nowrap;
