{
  "name": "newafro-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "newafro.com — Astro + Decap CMS, deployed to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:cms-config": "node scripts/check-cms-config.mjs",
    "check:content-assets": "node scripts/check-content-assets.mjs",
    "check:preview-release": "node scripts/check-preview-release.mjs",
    "check:cms-readiness": "node scripts/check-public-cms-readiness.mjs",
    "check:pages-readiness": "./scripts/check-pages-readiness.sh",
    "check:preview-review": "PREVIEW_REVIEW_ONLY=1 node scripts/check-first-designer-readiness.mjs",
    "check:first-designer": "node scripts/check-first-designer-readiness.mjs",
    "status:release": "node scripts/print-release-status.mjs",
    "smoke:public": "node scripts/smoke-public-browser.mjs",
    "astro": "astro",
    "audit:wix-parity": "node scripts/audit-wix-parity.mjs",
    "capture:wix-reference": "node scripts/capture-wix-reference.mjs",
    "capture:wix-reference:all": "REFERENCE_SCOPE=all node scripts/capture-wix-reference.mjs",
    "capture:parity-review": "node scripts/capture-parity-review.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "astro": "^4.16.18"
  },
  "devDependencies": {
    "js-yaml": "^4.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "ws": "^8.20.1"
  }
}
